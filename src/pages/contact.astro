---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { href } from '../lib/data';
import { breadcrumbNode, pageGraph, webPageNode } from '../lib/schema';

const title = 'Contact | RV Storage Prices';
const description =
  'Email contact@rvstorageprices.com to correct a listing, add or claim a facility, or ask about featured placement.';
const path = '/contact/';
const checked = '2026-11-20';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Contact', path },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: checked }),
  breadcrumbNode(crumbs),
]);
const mail = 'contact@rvstorageprices.com';
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>Contact</h1>
    <p>
      Write to <a href={`mailto:${mail}`}>{mail}</a>. This directory has no phone line for the site
      itself. A phone number on a facility card belongs to that business.
    </p>
    <h2>Corrections</h2>
    <p>
      If a price, address, or amenity is wrong, email the facility name, the city, and what changed.
      <a href={`mailto:${mail}?subject=Listing%20correction`}>Start a correction</a>.
      Prices on the cards are copied from a public page on the date shown. Calling the facility is the
      way to confirm a rate.
    </p>
    <h2>Add or claim a listing</h2>
    <p>
      A facility owner can ask to add a lot or to claim the card for a lot already listed. Include the
      street address and the page that shows RV or boat storage.
      <a href={`mailto:${mail}?subject=Add%20or%20claim%20a%20listing`}>Add or claim a listing</a>.
    </p>
    <h2>Featured placement</h2>
    <p>
      Featured placement is a labeled advertisement. It is not a review and it does not change a price
      the facility did not publish.
      <a href={`mailto:${mail}?subject=Featured%20placement`}>Ask about featured placement</a>
      or read <a href={href('/advertise/')}>how featuring works</a>.
    </p>
    <p>
      <a href={href('/about/')}>How listings are checked</a>
      {' · '}
      <a href={href('/privacy/')}>Privacy</a>
      {' · '}
      <a href={href('/terms/')}>Terms</a>
    </p>
  </article>
</Base>
