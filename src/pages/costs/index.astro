---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getStates, href } from '../../lib/data';
import { formatMonthlyRange, monthlySpan, parsePriceNote } from '../../lib/prices';
import { breadcrumbNode, pageGraph, webPageNode } from '../../lib/schema';

const states = getStates().map((state) => {
  const notes = state.cities.flatMap((city) => city.listings.map((listing) => parsePriceNote(listing.price_notes).monthly));
  return { state, span: monthlySpan(notes), total: state.cities.reduce((sum, city) => sum + city.listings.length, 0) };
});
const title = 'Monthly RV storage prices by city | RV Storage Finder';
const description =
  'Monthly dollar amounts copied from facility pages, grouped by state and city. Per-foot rates stay separate. Nothing on this page is an average.';
const path = '/costs/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Prices', path },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: states.flatMap((item) => item.state.cities.flatMap((city) => city.listings.map((listing) => listing.last_verified))).sort().at(-1) }),
  breadcrumbNode(crumbs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Published monthly prices</h1>
    <p class="summary">
      A figure appears here only when the facility page ties a dollar amount to a month. A per-foot rate
      stays on the city price page and is not converted into a month. These pages do not average the
      numbers.
    </p>
    {
      states.map(({ state, span, total }) => (
        <section>
          <h2>
            <a href={href(`/costs/${state.slug}/`)}>{state.name}</a>
          </h2>
          <p>
            {span.count} of {total} facilities print a monthly amount
            {span.low != null && span.high != null ? `, ${formatMonthlyRange(span.low, span.high)}.` : '.'}
          </p>
          <ul class="jump">
            {state.cities.map((city) => (
              <li>
                <a href={href(`/costs/${city.id}/`)}>{city.city}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
