---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListingCard from '../../components/ListingCard.astro';
import Mark from '../../components/Mark.astro';
import ResultMap from '../../components/ResultMap.astro';
import { facilityPath, getFacilities, href, type FacilityRecord } from '../../lib/data';
import { facilityPhoto } from '../../lib/facility-photos';
import {
  factClass,
  formatBool,
  formatDate,
  formatFeet,
  formatTypes,
  formatVehicles,
  mapUrl,
  telHref,
} from '../../lib/format';
import { coverLabel, priceLines, priceLineText, parsePriceNote, type CoverKind } from '../../lib/prices';
import { breadcrumbNode, listingNode, pageGraph, webPageNode } from '../../lib/schema';
import { feeFields, termLabel } from '../../lib/terms';
import { normalizeZip, zipCentroids } from '../../lib/zips';

export function getStaticPaths() {
  return getFacilities().map((record) => ({
    params: { slug: record.listing.slug },
    props: { record },
  }));
}

interface Props {
  record: FacilityRecord;
}

const { record } = Astro.props;
const { listing } = record;
const shot = facilityPhoto(listing.slug);
const path = facilityPath(listing.slug);
const addressLine = `${listing.street}, ${listing.city}, ${listing.state_code}${listing.postal_code ? ` ${listing.postal_code}` : ''}`;
function asHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
const brand = ' | RV Storage Prices';
const titleFull = `${listing.name}, ${listing.street}`;
let titleHead = titleFull;
if (asHtml(`${titleHead}${brand}`).length > 90) {
  const mark = ` · ${listing.slug.slice(-8)}`;
  while (asHtml(`${titleHead}…${mark}${brand}`).length > 90 && titleHead.length > 8) {
    titleHead = titleHead.slice(0, -1).trimEnd();
  }
  titleHead = `${titleHead}…${mark}`;
}
const title = `${titleHead}${brand}`;
const descriptionFull = `${listing.name} at ${addressLine}. ${formatVehicles(listing.vehicles)}. A price is shown only when this facility published one.`;
const descriptionShort = `${listing.name} at ${addressLine}. A price is shown only when this facility published one.`;
let description = asHtml(descriptionFull).length <= 220 ? descriptionFull : descriptionShort;
if (asHtml(description).length > 220) {
  let cut = descriptionShort;
  while (asHtml(`${cut}...`).length > 220 && cut.length > 40) cut = cut.slice(0, -1).trimEnd();
  description = `${cut}...`;
}
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'States', path: '/states/' },
  { label: record.stateName, path: record.statePath },
  { label: `${record.placeName}, ${record.placeCode}`, path: record.placePath },
  { label: listing.name, path },
];
const lines = priceLines(listing);
const groups = (['open', 'covered', 'enclosed', null] as const)
  .map((cover) => ({
    cover,
    lines: lines.filter((line) => line.cover === cover),
  }))
  .filter((group) => group.lines.length);
const facts = [
  { label: 'Vehicles', value: formatVehicles(listing.vehicles), kind: 'text' },
  { label: 'Storage', value: formatTypes(listing.storage_types), kind: listing.storage_types.length ? 'text' : 'unknown' },
  { label: 'Longest length listed', value: formatFeet(listing.max_length_ft), kind: listing.max_length_ft == null ? 'unknown' : 'text' },
  { label: 'Tallest clearance listed', value: formatFeet(listing.clearance_ft), kind: listing.clearance_ft == null ? 'unknown' : 'text' },
  { label: 'Power hookups', value: formatBool(listing.power_hookups), kind: factClass(listing.power_hookups) },
  { label: 'Dump station', value: formatBool(listing.dump_station), kind: factClass(listing.dump_station) },
  { label: 'Wash station', value: formatBool(listing.wash_station), kind: factClass(listing.wash_station) },
  { label: 'Gated', value: formatBool(listing.gated), kind: factClass(listing.gated) },
  { label: 'Cameras', value: formatBool(listing.cameras), kind: factClass(listing.cameras) },
  { label: '24-hour access', value: formatBool(listing.access_24h), kind: factClass(listing.access_24h) },
  ...(listing.access_hours ? [{ label: 'Gate hours', value: listing.access_hours, kind: 'text' }] : []),
];
const centroids = zipCentroids();
let lat = listing.lat;
let lng = listing.lng;
let approx: 'exact' | 'zip' | null = lat != null && lng != null ? 'exact' : null;
if (lat == null || lng == null) {
  const zip = normalizeZip(listing.postal_code);
  const centroid = zip ? centroids[zip] : undefined;
  if (centroid) {
    lat = centroid.lat;
    lng = centroid.lng;
    approx = 'zip';
  }
}
const monthly = parsePriceNote(listing.price_notes).monthly;
const mapPoints = lat != null && lng != null
  ? [{
      id: listing.slug,
      name: listing.name,
      lat,
      lng,
      price: monthly.length ? Math.min(...monthly) : null,
      approx: approx === 'zip' ? 'zip' : 'exact',
    }]
  : [];
const mapJson = JSON.stringify(mapPoints).replaceAll('<', '\\u003c');
const claimHref = `${href('/claim/')}?facility=${encodeURIComponent(listing.name)}`;
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: listing.last_verified }),
  breadcrumbNode(crumbs),
  listingNode(listing),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap facility-page">
    <Breadcrumbs items={crumbs} />
    <div class="facility-top">
      <div class="facility-hero">
        {
          shot ? (
            <figure class="facility-hero-photo">
              <img
                src={href(`/${shot.files['1024']}`)}
                srcset={`${href(`/${shot.files['640']}`)} 640w, ${href(`/${shot.files['1024']}`)} 1024w`}
                sizes="(min-width: 900px) 640px, 100vw"
                width={shot.width}
                height={shot.height}
                alt={`Street-level photo of ${listing.name}`}
                decoding="async"
              />
              <figcaption>
                <a href={shot.source_url} rel="noopener noreferrer" target="_blank">
                  Photo: {shot.creator} / Mapillary, CC BY-SA 4.0
                </a>
              </figcaption>
            </figure>
          ) : (
            <div class="facility-hero-empty">
              <Mark size={72} />
              <span>No photo</span>
            </div>
          )
        }
      </div>
      <section class="summary-box" id={listing.slug}>
        <h1>{listing.name}</h1>
        <p class="card-address">{addressLine}</p>
        {
          groups.length ? (
            <ul class="price-rows">
              {groups.flatMap((group) =>
                group.lines.map((line) => (
                  <li>
                    <span>{group.cover ? `${coverLabel[group.cover as CoverKind]} parking` : 'Published rate'}</span>
                    <strong>{priceLineText(line, false)}</strong>
                  </li>
                )),
              )}
            </ul>
          ) : (
            <p class="price-missing">Price not posted</p>
          )
        }
        <ul class="icon-row" aria-label="Published features">
          {listing.vehicles.includes('rv') && <li>RV</li>}
          {listing.vehicles.includes('boat') && <li>Boat</li>}
          {listing.storage_types.includes('covered') && <li>Covered</li>}
          {listing.storage_types.includes('enclosed') && <li>Enclosed</li>}
          {listing.storage_types.includes('open') && <li>Open</li>}
          {listing.power_hookups === true && <li>Power</li>}
          {listing.gated === true && <li>Gated</li>}
        </ul>
        <div class="summary-actions">
          {
            listing.phone && (
              <a class="action-primary" href={telHref(listing.phone)}>Call {listing.phone}</a>
            )
          }
          {
            listing.website && (
              <a class="action-secondary" href={listing.website} rel="noopener noreferrer" target="_blank">
                Website<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
              </a>
            )
          }
          <a class="action-secondary" href={mapUrl(listing)} rel="noopener noreferrer" target="_blank">
            Directions<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
          </a>
        </div>
      </section>
    </div>
    {
      mapPoints.length > 0 && (
        <ResultMap compact>
          <script slot="points" id="map-points" type="application/json" set:html={mapJson} />
        </ResultMap>
      )
    }
    <section class="facility-facts">
      <h2>What the facility published</h2>
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd class={fact.kind}>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <p>
        <span class="label">Terms</span><br />
        <span class={listing.billing_term ? undefined : 'unknown'}>
          {termLabel(listing.billing_term)}
          {listing.billing_detail ? ` ${listing.billing_detail}` : ''}
        </span>
      </p>
      <h2>Published fees</h2>
      <dl class="facts">
        {feeFields.map(([key, label]) => (
          <div>
            <dt>{label}</dt>
            <dd class={listing.fees[key] ? undefined : 'unknown'}>{listing.fees[key] ?? 'Not listed'}</dd>
          </div>
        ))}
      </dl>
      {listing.price_notes && <p class="note">{listing.price_notes}</p>}
      <p>
        <span class="label">Waitlist</span><br />
        <span class={listing.waitlist ? undefined : 'unknown'}>{listing.waitlist ?? 'Not listed'}</span>
      </p>
      {listing.notes && <p class="note">{listing.notes}</p>}
      <p class="checked">
        Checked <time datetime={listing.last_verified}>{formatDate(listing.last_verified)}</time>
      </p>
      <p class="source-label">Sources</p>
      <ul class="sources">
        {listing.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="fine">
        <a href={claimHref}>Claim this listing</a>
        {' · '}
        <a href={href('/advertise/')}>Featured spot, $29</a>
        {' · '}
        <a href={href(record.placePath)}>All listings in {record.placeName}</a>
      </p>
    </section>
    {
      record.nearby.length > 0 && (
        <section>
          <h2>Nearby facilities</h2>
          <p class="fine">Other facilities on the {record.placeName} page. Each card uses that facility’s own published price.</p>
          <div data-listing-list>
            {record.nearby.map((item) => <ListingCard listing={item} />)}
          </div>
        </section>
      )
    }
  </div>
</Base>
