---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StateLots from '../../components/StateLots.astro';
import { href } from '../../lib/data';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

const title = 'Can a Florida HOA ban RV parking? | RV Storage Prices';
const description =
  'Florida Statutes section 720.3045 is quoted from the Senate site. It limits some HOA bans on an RV that is not visible from listed places. Not legal advice.';
const path = '/guides/can-hoa-ban-rv-parking-florida/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path: '/guides/' },
  { label: 'Florida HOA parking', path },
];
const faqs = [
  {
    q: 'Can a Florida HOA ban RV parking?',
    a: 'Section 720.3045 says an association may not restrict storing items on a parcel that are not visible from the parcel’s frontage, an adjacent parcel, an adjacent common area, or a community golf course, and it names boats and recreational vehicles. It is not legal advice and it does not read your declaration.',
  },
  {
    q: 'Does that statute cover a visible driveway?',
    a: 'The quoted sentence is about items that are not visible from the listed places. It does not say a visible RV in a driveway is allowed. Read the longer note on the Florida rules page.',
  },
  {
    q: 'Where is off-site RV storage in Florida?',
    a: 'The city list at the bottom of this page links the Florida storage lots in this directory. A listing is not a statement that an association allows the vehicle at the house.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: '2026-11-20' }),
  breadcrumbNode(crumbs),
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>Can a Florida HOA ban RV parking?</h1>
    <p>
      This is not legal advice, not a ruling on your declaration, and not a substitute for the city or
      county code. The longer note is the
      <a href={href('/rules/florida/')}>Florida HOA rules page</a>. Checked November 19, 2026.
    </p>
    <p>
      The sentence below matched on the
      <a href="https://www.flsenate.gov/Laws/Statutes/2025/720.3045" rel="noopener noreferrer">2025 Florida Statutes, section 720.3045</a>
      and on
      <a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0720/Sections/0720.3045.html" rel="noopener noreferrer">Online Sunshine’s 2026 statutes, section 720.3045</a>.
    </p>
    <blockquote>
      <p>
        720.3045 Installation, display, and storage of items.— Regardless of any covenants, restrictions,
        bylaws, rules, or requirements of an association, and unless prohibited by general law or local
        ordinance, an association may not restrict parcel owners or their tenants from installing,
        displaying, or storing any items on a parcel which are not visible from the parcel’s frontage or
        an adjacent parcel, an adjacent common area, or a community golf course, including, but not
        limited to, artificial turf, boats, flags, vegetable gardens, clotheslines, and recreational
        vehicles.
      </p>
    </blockquote>
    <p>
      The sentence is about items that are not visible from those places. It does not decide a visible
      driveway, a condominium, or a local ordinance.
    </p>
    <StateLots stateSlug="florida" inputId="hoa-fl" />
    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </section>
  </article>
</Base>
