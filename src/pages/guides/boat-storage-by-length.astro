---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { href } from '../../lib/data';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

const title = 'Boat storage by length | RV Storage Prices';
const description =
  'How to compare a boat and trailer with a published storage length. City lists start at 30 feet and 40 feet, and only when three facilities print a long enough maximum.';
const path = '/guides/boat-storage-by-length/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path: '/guides/' },
  { label: 'Boat storage by length', path },
];
const faqs = [
  {
    q: 'How should I measure a boat for storage?',
    a: 'Measure the overall length the lot will see, usually the boat on its trailer with the tongue included, and the height at the highest point. Compare those numbers with the maximum and clearance the facility printed.',
  },
  {
    q: 'Why are there only two length lists?',
    a: 'The directory publishes city pages at 30 feet and 40 feet. A city appears only when three facilities state a boat and a maximum at least that long.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: '2026-11-20' }),
  breadcrumbNode(crumbs),
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>Boat storage by length</h1>
    <p>
      A boat type, such as a pontoon or a center console, is not turned into a length. If the facility
      page does not print a maximum, the boat is not placed on a length list.
    </p>
    <ul>
      <li><a href={href('/guides/30-foot-boat-storage/')}>30-foot boat storage</a></li>
      <li><a href={href('/guides/40-foot-boat-storage/')}>40-foot boat storage</a></li>
    </ul>
    <p>
      RV length lists: <a href={href('/guides/30-foot-rv-storage/')}>30</a>,
      <a href={href('/guides/35-foot-rv-storage/')}>35</a>,
      <a href={href('/guides/40-foot-rv-storage/')}>40</a>, and
      <a href={href('/guides/45-foot-rv-storage/')}>45 feet</a>.
    </p>
    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </section>
  </article>
</Base>
