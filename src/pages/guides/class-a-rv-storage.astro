---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { href } from '../../lib/data';
import { classARows } from '../../lib/fit';
import { formatFeet } from '../../lib/format';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

const title = 'Class A RV storage | RV Storage Prices';
const description =
  'Facilities whose own pages say Class A, with the length they printed. A long published maximum is not treated as Class A acceptance.';
const path = '/guides/class-a-rv-storage/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path: '/guides/' },
  { label: 'Class A RV storage', path },
];
const faqs = [
  {
    q: 'What should I measure on a Class A motorhome?',
    a: 'Overall length from the front cap to the rearmost point, including a ladder or spare, and height at the tallest roof equipment. Compare height with the clearance printed for a covered or enclosed space. Ask about the turn into the gate. This directory does not print a turning radius the facility did not publish.',
  },
  {
    q: 'If a lot allows 40 feet, does it allow a Class A?',
    a: 'Not from this directory. Class A is listed only when the facility page says Class A. Published length lists are separate.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: '2026-11-20' }),
  breadcrumbNode(crumbs),
  faqNode(faqs),
]);
const rows = classARows();
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>Class A RV storage</h1>
    <p>
      These facilities use the words Class A on the page we checked. The published maximum length is
      shown beside the name when the page printed one. A long maximum on another lot is not added here.
      Those lots are on the
      <a href={href('/guides/40-foot-rv-storage/')}>40-foot</a> and
      <a href={href('/guides/45-foot-rv-storage/')}>45-foot</a> length guides.
    </p>
    <ul>
      {
        rows.map((row) => (
          <li>
            <a href={href(`/cities/${row.city.id}/#${row.listing.slug}`)}>{row.listing.name}</a>
            {` · ${row.listing.city}, ${row.listing.state_code} · published maximum ${formatFeet(row.listing.max_length_ft)}`}
          </li>
        ))
      }
    </ul>
    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </section>
  </article>
</Base>
