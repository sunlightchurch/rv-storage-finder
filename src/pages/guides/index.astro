---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { directoryStats, href } from '../../lib/data';
import { formatBand, getCityCostGuides, getCompareCostGuide } from '../../lib/guides';
import { breadcrumbNode, pageGraph, webPageNode } from '../../lib/schema';

const cities = getCityCostGuides();
const compare = getCompareCostGuide();
const title = 'RV storage cost guides | RV Storage Prices';
const description =
  'Monthly RV storage prices from facilities that published a rate. City pages give the low, median, and high. A blank price is not guessed.';
const path = '/guides/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: directoryStats().latest }),
  breadcrumbNode(crumbs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>RV storage cost guides</h1>
    <p class="summary">
      These pages use only monthly dollar amounts already printed on a facility page in this directory.
      A note that does not say “per month” is left out. Cities with fewer than three facilities that
      published a monthly price are not given a page.
    </p>
    <h2>Rig length and Class A</h2>
    <ul>
      <li><a href={href('/guides/class-a-rv-storage/')}>Class A RV storage</a></li>
      <li><a href={href('/guides/30-foot-rv-storage/')}>30-foot RV storage</a></li>
      <li><a href={href('/guides/35-foot-rv-storage/')}>35-foot RV storage</a></li>
      <li><a href={href('/guides/40-foot-rv-storage/')}>40-foot RV storage</a></li>
      <li><a href={href('/guides/45-foot-rv-storage/')}>45-foot RV storage</a></li>
      <li><a href={href('/guides/boat-storage-by-length/')}>Boat storage by length</a></li>
    </ul>
    <h2>Seasonal storage, fees, and HOA rules</h2>
    <ul>
      <li><a href={href('/guides/snowbird-rv-storage-florida/')}>Snowbird RV storage in Florida</a></li>
      <li><a href={href('/guides/hurricane-season-rv-boat-storage-florida/')}>Hurricane-season RV and boat storage in Florida</a></li>
      <li><a href={href('/guides/snowbird-rv-storage-arizona/')}>Snowbird RV storage in Arizona</a></li>
      <li><a href={href('/guides/short-term-rv-storage/')}>Short-term and month-to-month storage</a></li>
      <li><a href={href('/guides/rv-storage-fees-move-in-costs/')}>Fees and move-in costs</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-florida/')}>Can a Florida HOA ban RV parking?</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-arizona/')}>Can an Arizona HOA ban RV parking?</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-texas/')}>Can a Texas HOA ban RV parking?</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-georgia/')}>Can a Georgia HOA ban RV parking?</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-nevada/')}>Can a Nevada HOA ban RV parking?</a></li>
      <li><a href={href('/guides/can-hoa-ban-rv-parking-north-carolina/')}>Can a North Carolina HOA ban RV parking?</a></li>
    </ul>
    <ul>
      <li>
        <a href={href(compare.path)}>Covered vs uncovered vs indoor RV storage</a>
        <span class="fine"> {compare.sampledFacilities} facilities with a monthly price</span>
      </li>
      {
        cities.map((guide) => (
          <li>
            <a href={href(guide.path)}>
              How much does RV storage cost in {guide.city.city}, {guide.city.state_code}?
            </a>
            <span class="fine">
              {' '}
              {formatBand(guide.overall.min)}–{formatBand(guide.overall.max)} · {guide.sampled.length} facilities
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
