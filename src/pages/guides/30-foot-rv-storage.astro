---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LengthGuide from '../../components/LengthGuide.astro';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

const feet = 30;
const title = '30-foot RV storage | RV Storage Prices';
const description =
  'Cities where at least three facilities publish a maximum RV length of 30 feet or more. Length is taken from the facility page, not guessed.';
const path = '/guides/30-foot-rv-storage/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path: '/guides/' },
  { label: '30-foot RV storage', path },
];
const faqs = [
  {
    q: 'What counts as a 30-foot RV space?',
    a: 'A facility is listed only when its page publishes a maximum length of at least 30 feet and says it stores an RV. A page that never prints a length is left out.',
  },
  {
    q: 'Should I measure the hitch?',
    a: 'Yes. Overall length includes the hitch, a rear ladder, and a spare tire. The number on the brochure for the living area can be shorter than the number the lot uses.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: '2026-11-20' }),
  breadcrumbNode(crumbs),
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>30-foot RV storage</h1>
    <LengthGuide kind="rv" feet={feet} />
    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </section>
  </article>
</Base>
