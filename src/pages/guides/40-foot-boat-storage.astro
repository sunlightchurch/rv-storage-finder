---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LengthGuide from '../../components/LengthGuide.astro';
import { href } from '../../lib/data';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

const title = '40-foot boat storage | RV Storage Prices';
const description =
  'Cities where at least three facilities publish a maximum length of 40 feet or more and say they store a boat. No length is inferred from the boat type.';
const path = '/guides/40-foot-boat-storage/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Guides', path: '/guides/' },
  { label: '40-foot boat storage', path },
];
const faqs = [
  {
    q: 'How is a 40-foot boat chosen for this list?',
    a: 'The facility page must say it stores a boat and must print a maximum length of at least 40 feet. A boat page with no length is not included.',
  },
  {
    q: 'What about height and the trailer tongue?',
    a: 'Compare the tallest point with any printed clearance, and include the tongue in the overall length you measure. The card uses only the number the facility published.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: '2026-11-20' }),
  breadcrumbNode(crumbs),
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1>40-foot boat storage</h1>
    <p>
      The lower cutoff is <a href={href('/guides/30-foot-boat-storage/')}>30-foot boat storage</a>.
      Both guides are linked from the
      <a href={href('/guides/boat-storage-by-length/')}>boat storage by length</a> page.
    </p>
    <LengthGuide kind="boat" feet={40} />
    <section class="faq">
      <h2>Questions</h2>
      {faqs.map((faq) => (
        <>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </>
      ))}
    </section>
  </article>
</Base>
