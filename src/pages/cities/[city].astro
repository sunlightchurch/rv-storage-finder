---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CityStats from '../../components/CityStats.astro';
import FilterChips from '../../components/FilterChips.astro';
import FindMore from '../../components/FindMore.astro';
import ListingCard from '../../components/ListingCard.astro';
import Photo from '../../components/Photo.astro';
import ResultMap from '../../components/ResultMap.astro';
import { correctionMailto, getCities, getCity, getFilterPages, href, siblingCities, stateSlug } from '../../lib/data';
import { pageIsThin, parsePriceNote } from '../../lib/prices';
import { cityTitle, placeDescription } from '../../lib/seo';
import { formatBool, formatDate, formatFeet, formatTypes, formatVehicles } from '../../lib/format';
import { formatPriceBlock } from '../../lib/prices';
import { fitPagesForCity } from '../../lib/fit';
import { termLabel } from '../../lib/terms';
import { normalizeZip, zipCentroids } from '../../lib/zips';
import { getPhoto } from '../../lib/photos';
import { breadcrumbNode, faqNode, itemListNode, pageGraph, webPageNode } from '../../lib/schema';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { city: city.id } }));
}

const city = getCity(Astro.params.city!);
const path = `/cities/${city.id}/`;
const title = cityTitle(city);
const description = placeDescription(`${city.city}, ${city.state_code}`, city.listings);
const thin = pageIsThin(city.listings);
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'States', path: '/states/' },
  { label: city.state, path: `/states/${stateSlug(city.state)}/` },
  { label: `${city.city}, ${city.state_code}`, path },
];
const priced = city.listings.filter((listing) => listing.price_notes).length;
const faqs = [
  {
    q: `How many RV and boat storage facilities are listed in ${city.city}?`,
    a: `${city.listings.length} facilities are listed, each with a public source. This is not a complete inventory of every lot in ${city.metro}.`,
  },
  {
    q: `Do the ${city.city} listings publish monthly prices?`,
    a:
      priced > 0
        ? `${priced} of ${city.listings.length} facilities print a price on the source we checked. Those notes are copied onto the card and are not averaged. The rest say not listed.`
        : `None of the ${city.listings.length} sources we checked printed a price, so every price says not listed.`,
  },
];
const latest = city.listings.map((listing) => listing.last_verified).sort().at(-1);
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: latest }),
  breadcrumbNode(crumbs),
  itemListNode(`RV and boat storage in ${city.city}, ${city.state_code}`, city.listings),
  faqNode(faqs),
]);
const siblings = siblingCities(city);
const reportedFull = city.listings.filter((listing) => listing.waitlist);
const notReportedFull = city.listings.filter((listing) => !listing.waitlist);
const correctionHref = correctionMailto(city.city);
const centroids = zipCentroids();
const pageCentroids: Record<string, { lat: number; lng: number }> = {};
for (const listing of city.listings) {
  const zip = normalizeZip(listing.postal_code);
  if (zip && centroids[zip]) pageCentroids[zip] = centroids[zip];
}
const mapPoints = city.listings.flatMap((listing) => {
  let lat = listing.lat;
  let lng = listing.lng;
  let approx: 'exact' | 'zip' = 'exact';
  if (lat == null || lng == null) {
    const zip = normalizeZip(listing.postal_code);
    const centroid = zip ? centroids[zip] : undefined;
    if (!centroid) return [];
    lat = centroid.lat;
    lng = centroid.lng;
    approx = 'zip';
  }
  const monthly = parsePriceNote(listing.price_notes).monthly;
  return [{
    id: listing.slug,
    name: listing.name,
    lat,
    lng,
    price: monthly.length ? Math.min(...monthly) : null,
    approx,
  }];
});
const mapJson = JSON.stringify(mapPoints).replaceAll('<', '\\u003c');
const compareListings = city.listings.map((listing) => ({
  slug: listing.slug,
  name: listing.name,
  address: `${listing.street}, ${listing.city}, ${listing.state_code}${listing.postal_code ? ` ${listing.postal_code}` : ''}`,
  vehicles: formatVehicles(listing.vehicles),
  storage: formatTypes(listing.storage_types),
  length: formatFeet(listing.max_length_ft),
  clearance: formatFeet(listing.clearance_ft),
  power: formatBool(listing.power_hookups),
  dump: formatBool(listing.dump_station),
  wash: formatBool(listing.wash_station),
  gated: formatBool(listing.gated),
  cameras: formatBool(listing.cameras),
  access: formatBool(listing.access_24h),
  hours: listing.access_hours ?? 'Not listed',
  waitlist: listing.waitlist ?? 'Not listed',
  price: formatPriceBlock(listing),
  terms: listing.billing_detail ? `${termLabel(listing.billing_term)} ${listing.billing_detail}` : termLabel(listing.billing_term),
  feeAdmin: listing.fees.admin ?? 'Not listed',
  feeGate: listing.fees.gate_card ?? 'Not listed',
  feeDeposit: listing.fees.deposit ?? 'Not listed',
  feeAccess: listing.fees.access_24h ?? 'Not listed',
  feeLate: listing.fees.late ?? 'Not listed',
  feeLock: listing.fees.lock_or_insurance ?? 'Not listed',
  phone: listing.phone,
  website: listing.website,
  checked: formatDate(listing.last_verified),
}));
const compareJson = JSON.stringify(compareListings).replaceAll('<', '\\u003c');
const orderedListings = [...city.listings].sort((a, b) => Number(b.featured) - Number(a.featured));
const shortTermPage = getFilterPages().find((page) => page.city.id === city.id && page.filter.id === 'short-term');
const fitPages = fitPagesForCity(city.id);
const hoaGuide: Record<string, string> = {
  FL: '/guides/can-hoa-ban-rv-parking-florida/',
  AZ: '/guides/can-hoa-ban-rv-parking-arizona/',
  TX: '/guides/can-hoa-ban-rv-parking-texas/',
  GA: '/guides/can-hoa-ban-rv-parking-georgia/',
  NV: '/guides/can-hoa-ban-rv-parking-nevada/',
  NC: '/guides/can-hoa-ban-rv-parking-north-carolina/',
};
const snowbirdGuide =
  city.state_code === 'FL'
    ? '/guides/snowbird-rv-storage-florida/'
    : city.state_code === 'AZ'
      ? '/guides/snowbird-rv-storage-arizona/'
      : null;
---

<Base title={title} description={description} path={path} schema={schema} noindex={thin}>
  <div class="wrap" data-filter-root>
    <Breadcrumbs items={crumbs} />
    <Photo photo={getPhoto(city.photo)} sizes="(min-width: 900px) 1100px, 100vw" eager />
    <p class="eyebrow">{city.metro}</p>
    <h1>RV and boat storage in {city.city}, {city.state_code}</h1>
    <CityStats listings={city.listings} />
    <p class="type-note" data-type-note hidden>
      <span data-type-copy></span>
      <a href={href('/boat-storage/')} data-boat-hub hidden>Boat storage by state</a>
    </p>
    <p class="summary">{city.summary}</p>
    <FilterChips city={city} />
    <form class="distance-panel" data-distance-form data-distance-panel hidden>
      <button type="button" class="loc-primary" data-near-me>Use my location</button>
      <div class="loc-zip">
        <label>
          Or a ZIP
          <input type="text" inputmode="numeric" maxlength="5" pattern="[0-9]{5}" placeholder="33610" data-distance-zip aria-label={`ZIP code near ${city.city}`} />
        </label>
        <button type="submit">From this ZIP</button>
      </div>
      <button type="button" class="text-btn" data-distance-reset>Clear distance</button>
      <p class="fine" data-distance-summary aria-live="polite">Miles from you, or from a ZIP.</p>
      <script id="zip-centroids" type="application/json" set:html={JSON.stringify(pageCentroids)} />
    </form>
    <details class="check-note">
      <summary>How we check listings</summary>
      <p>
        Yes means the source says so. No means the source says it does not. Not listed means the page we
        checked is silent. A price sort uses the lowest monthly amount printed. A lot with no monthly
        price stays last. Distance uses a map point when the page printed one, and otherwise the center
        of the facility ZIP.
      </p>
      <p class="fine" data-sort-status></p>
    </details>
    <p class="legend" data-filter-empty hidden>No facilities on this page match that filter.</p>
    <form class="budget" data-fit-form>
      <h2>Will my rig fit?</h2>
      <label>
        Length in feet
        <input type="number" inputmode="decimal" min="1" max="120" step="1" value="30" data-fit-length />
      </label>
      <label>
        Height in feet
        <input type="number" inputmode="decimal" min="1" max="20" step="0.5" value="13" data-fit-height />
      </label>
      <button type="submit">Check published limits</button>
      <p class="fine" data-fit-summary aria-live="polite">
        Compare this length and height with the longest length and tallest clearance each facility printed.
        A blank limit is not a yes.
      </p>
    </form>
    <section class="compare" id="compare" data-compare>
      <h2>Compare side by side</h2>
      <p class="fine" data-compare-summary>
        Check Compare on two or three facilities. A blank stays “Not listed.” A row is marked when the
        facilities do not all say the same thing.
      </p>
      <button type="button" data-compare-clear>Clear comparison</button>
      <div class="table-wrap" data-compare-mount></div>
      <script id="compare-listings" type="application/json" set:html={compareJson} />
    </section>
    <h2>Facilities</h2>
    <p class="fine">
      <a href={href('/advertise/')}>Own a storage facility? Get featured</a>
    </p>
    <ResultMap>
      <div data-listing-list>
        {orderedListings.map((listing) => <ListingCard listing={listing} />)}
      </div>
      <script slot="points" id="map-points" type="application/json" set:html={mapJson} />
    </ResultMap>
    {
      reportedFull.length > 0 && (
        <section class="try-these">
          <h2>Lots full? Try these</h2>
          <p>
            {reportedFull.length} of {city.listings.length} facilities on this page reported a waitlist or no
            open space. The others did not say that. Not reported is not the same as a vacancy.
          </p>
          {
            notReportedFull.length > 0 ? (
              <ul>
                {notReportedFull.map((listing) => (
                  <li>
                    <a href={`#${listing.slug}`}>{listing.name}</a>
                    <span class="fine">
                      {' '}
                      {listing.city}, {listing.state_code}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p>Every facility on this page reported a waitlist. A lot in a nearby city may still have space.</p>
            )
          }
          <p>
            <a href={correctionHref}>Email a correction</a> if a lot filled up or a card is wrong.
          </p>
        </section>
      )
    }
    <section class="faq">
      <h2>Questions about {city.city}, {city.state_code}</h2>
      {
        faqs.map((faq) => (
          <>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </>
        ))
      }
    </section>
    <FindMore city={city} />
    <h2>Guides for this city</h2>
    <p class="cross">
      {snowbirdGuide && <a href={href(snowbirdGuide)}>Snowbird storage</a>}
      {city.state_code === 'FL' && (
        <a href={href('/guides/hurricane-season-rv-boat-storage-florida/')}>Hurricane-season storage</a>
      )}
      <a href={href('/guides/short-term-rv-storage/')}>Short-term terms</a>
      {shortTermPage && <a href={href(shortTermPage.path)}>Short-term filter for this city</a>}
      <a href={href('/guides/rv-storage-fees-move-in-costs/')}>Move-in fees</a>
      {hoaGuide[city.state_code] && <a href={href(hoaGuide[city.state_code])}>Can an HOA ban an RV?</a>}
      {fitPages.map((page) => (
        <a href={href(page.path)}>
          {page.feet}-foot {page.kind === 'rv' ? 'RV' : 'boat'}
        </a>
      ))}
    </p>
    <h2>Keep browsing</h2>
    <p class="cross">
      <a href={href(`/states/${stateSlug(city.state)}/`)}>All {city.state} cities</a>
      <a href={href(`/costs/${city.id}/`)}>Monthly prices in {city.city}, {city.state_code}</a>
      <a href={href('/guide/')}>What RV storage costs</a>
      {siblings.map((sibling) => <a href={href(`/cities/${sibling.id}/`)}>{sibling.city}, {sibling.state_code}</a>)}
    </p>
  </div>
  <script>
    function milesBetween(a: { lat: number; lng: number }, b: { lat: number; lng: number }): number {
      const toRad = (value: number) => (value * Math.PI) / 180;
      const dLat = toRad(b.lat - a.lat);
      const dLng = toRad(b.lng - a.lng);
      const lat1 = toRad(a.lat);
      const lat2 = toRad(b.lat);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
      return 3958.8 * 2 * Math.asin(Math.min(1, Math.sqrt(h)));
    }

    function formatMiles(miles: number): string {
      return miles < 10 ? miles.toFixed(1) : String(Math.round(miles));
    }

    document.querySelectorAll('[data-distance-form]').forEach((form) => {
      const root = form.closest('[data-filter-root]') ?? document;
      const list = root.querySelector<HTMLElement>('[data-listing-list]');
      const zipInput = form.querySelector<HTMLInputElement>('[data-distance-zip]');
      const summary = form.querySelector<HTMLElement>('[data-distance-summary]');
      const centroidNode = form.querySelector('#zip-centroids');
      const centroids = centroidNode?.textContent ? (JSON.parse(centroidNode.textContent) as Record<string, { lat: number; lng: number }>) : {};
      const cards = () => [...(list?.querySelectorAll<HTMLElement>('[data-listing]') ?? [])];
      cards().forEach((card, index) => {
        card.dataset.order = String(index);
      });

      function pointFrom(card: HTMLElement): { lat: number; lng: number; precise: boolean; zip: string } | null {
        const lat = Number(card.getAttribute('data-lat'));
        const lng = Number(card.getAttribute('data-lng'));
        const zip = card.getAttribute('data-zip') ?? '';
        if (Number.isFinite(lat) && Number.isFinite(lng) && card.hasAttribute('data-lat')) {
          return { lat, lng, precise: true, zip };
        }
        const centroid = zip ? centroids[zip] : undefined;
        if (!centroid) return null;
        return { lat: centroid.lat, lng: centroid.lng, precise: false, zip };
      }

      function apply(origin: { lat: number; lng: number }, originLabel: string) {
        const ranked = cards().map((card) => {
          const point = pointFrom(card);
          const distance = point ? milesBetween(origin, point) : null;
          return { card, point, distance };
        });
        ranked.sort((a, b) => {
          if (a.distance == null && b.distance == null) return Number(a.card.dataset.order) - Number(b.card.dataset.order);
          if (a.distance == null) return 1;
          if (b.distance == null) return -1;
          return a.distance - b.distance || Number(a.card.dataset.order) - Number(b.card.dataset.order);
        });
        let known = 0;
        for (const item of ranked) {
          if (item.distance == null) delete item.card.dataset.miles;
          else item.card.dataset.miles = String(item.distance);
          const note = item.card.querySelector<HTMLElement>('[data-distance-note]');
          if (!note) continue;
          note.hidden = false;
          if (item.distance == null || !item.point) {
            note.textContent = 'Distance not listed.';
            continue;
          }
          known += 1;
          const amount = `${formatMiles(item.distance)} miles`;
          note.textContent = item.point.precise
            ? `${amount} ${originLabel}.`
            : `About ${amount} ${originLabel}.`;
        }
        const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');
        if (sortSelect) sortSelect.value = 'distance';
        const refresh = (window as Window & { refreshListingFilters?: () => void }).refreshListingFilters;
        if (refresh) refresh();
        else {
          for (const item of ranked) list?.append(item.card);
        }
        if (summary) {
          summary.textContent = known
            ? `${known} facilities sorted by distance. The rest stay last.`
            : 'No distance was available for these facilities.';
        }
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const zip = (zipInput?.value ?? '').replace(/\D/g, '').slice(0, 5);
        const origin = centroids[zip];
        if (!origin) {
          if (summary) summary.textContent = 'That ZIP is not in the lookup. Try a ZIP from a listed facility.';
          return;
        }
        apply(origin, `from ZIP ${zip}`);
      });

      form.querySelector('[data-near-me]')?.addEventListener('click', () => {
        if (!navigator.geolocation) {
          if (summary) summary.textContent = 'This browser does not share a location. Enter a ZIP instead.';
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (position) => {
            apply({ lat: position.coords.latitude, lng: position.coords.longitude }, 'from your location');
          },
          () => {
            if (summary) summary.textContent = 'Location access was blocked. Enter a ZIP instead.';
          },
          { enableHighAccuracy: false, timeout: 8000 },
        );
      });

      form.querySelector('[data-distance-reset]')?.addEventListener('click', () => {
        for (const card of cards()) {
          delete card.dataset.miles;
          const note = card.querySelector<HTMLElement>('[data-distance-note]');
          if (note) {
            note.hidden = true;
            note.textContent = '';
          }
        }
        const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');
        if (sortSelect) sortSelect.value = 'default';
        const refresh = (window as Window & { refreshListingFilters?: () => void }).refreshListingFilters;
        if (refresh) refresh();
        else {
          const ordered = cards().sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
          for (const card of ordered) list?.append(card);
        }
        if (summary) {
          summary.textContent = 'Distance cleared.';
        }
      });
    });
  </script>
  <script>
    function fitState(limit: number | null, needed: number): 'yes' | 'no' | 'unknown' {
      if (limit == null || Number.isNaN(limit)) return 'unknown';
      return needed <= limit ? 'yes' : 'no';
    }

    document.querySelectorAll('[data-fit-form]').forEach((form) => {
      const root = form.closest('[data-filter-root]') ?? document;
      const lengthInput = form.querySelector<HTMLInputElement>('[data-fit-length]');
      const heightInput = form.querySelector<HTMLInputElement>('[data-fit-height]');
      const summary = form.querySelector<HTMLElement>('[data-fit-summary]');

      function readLimit(card: Element, name: string): number | null {
        const raw = card.getAttribute(name);
        if (!raw) return null;
        const value = Number(raw);
        return Number.isFinite(value) ? value : null;
      }

      function check() {
        const length = Number(lengthInput?.value);
        const height = Number(heightInput?.value);
        if (!Number.isFinite(length) || !Number.isFinite(height) || length <= 0 || height <= 0) return;
        let fits = 0;
        let exceeds = 0;
        let unknown = 0;
        root.querySelectorAll('[data-listing]').forEach((card) => {
          const maxLength = readLimit(card, 'data-max-length');
          const clearance = readLimit(card, 'data-clearance');
          const lengthState = fitState(maxLength, length);
          const heightState = fitState(clearance, height);
          const note = card.querySelector<HTMLElement>('[data-fit-note]');
          let text = '';
          if (lengthState === 'no' || heightState === 'no') {
            exceeds += 1;
            const reasons = [
              lengthState === 'no' ? `published length is ${maxLength} ft` : '',
              heightState === 'no' ? `published clearance is ${clearance} ft` : '',
            ].filter(Boolean);
            text = `This rig is past a published limit: ${reasons.join('; ')}.`;
          } else if (lengthState === 'yes' && heightState === 'yes') {
            fits += 1;
            text = `Published limits cover ${length} ft long and ${height} ft tall.`;
          } else {
            unknown += 1;
            const missing = [
              lengthState === 'unknown' ? 'length' : '',
              heightState === 'unknown' ? 'height' : '',
            ].filter(Boolean);
            const known = [
              lengthState === 'yes' ? `length up to ${maxLength} ft fits` : '',
              heightState === 'yes' ? `clearance up to ${clearance} ft fits` : '',
            ].filter(Boolean);
            text =
              missing.length === 2
                ? 'Length and height are not listed, so this rig is not ruled in or out.'
                : `${missing.join(' and ')} ${missing.length === 1 ? 'is' : 'are'} not listed. ${known.join('. ')}.`;
          }
          if (note) {
            note.hidden = false;
            note.textContent = text;
          }
        });
        if (summary) {
          summary.textContent = `${fits} publish limits that cover this rig. ${exceeds} publish a shorter length or a lower clearance. ${unknown} are missing a limit, so they are not ruled in or out.`;
        }
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        check();
      });
      check();
    });
  </script>
  <script>
    type CompareListing = {
      slug: string;
      name: string;
      address: string;
      vehicles: string;
      storage: string;
      length: string;
      clearance: string;
      power: string;
      dump: string;
      wash: string;
      gated: string;
      cameras: string;
      access: string;
      hours: string;
      waitlist: string;
      price: string;
      terms: string;
      feeAdmin: string;
      feeGate: string;
      feeDeposit: string;
      feeAccess: string;
      feeLate: string;
      feeLock: string;
      phone: string | null;
      website: string | null;
      checked: string;
    };

    const compareRows: { label: string; key: keyof CompareListing }[] = [
      { label: 'Address', key: 'address' },
      { label: 'Vehicles', key: 'vehicles' },
      { label: 'Storage', key: 'storage' },
      { label: 'Longest length listed', key: 'length' },
      { label: 'Tallest clearance listed', key: 'clearance' },
      { label: 'Power hookups', key: 'power' },
      { label: 'Dump station', key: 'dump' },
      { label: 'Wash station', key: 'wash' },
      { label: 'Gated', key: 'gated' },
      { label: 'Cameras', key: 'cameras' },
      { label: '24-hour access', key: 'access' },
      { label: 'Gate hours', key: 'hours' },
      { label: 'Waitlist', key: 'waitlist' },
      { label: 'Published price', key: 'price' },
      { label: 'Terms', key: 'terms' },
      { label: 'Admin or setup', key: 'feeAdmin' },
      { label: 'Gate card', key: 'feeGate' },
      { label: 'Deposit', key: 'feeDeposit' },
      { label: '24-hour access fee', key: 'feeAccess' },
      { label: 'Late fee', key: 'feeLate' },
      { label: 'Required lock or insurance', key: 'feeLock' },
      { label: 'Phone', key: 'phone' },
      { label: 'Website', key: 'website' },
      { label: 'Checked', key: 'checked' },
    ];

    const idleSummary =
      'Check Compare on two or three facilities. A blank stays “Not listed.” A row is marked when the facilities do not all say the same thing.';

    function phoneHref(phone: string): string {
      const digits = phone.replace(/\D/g, '');
      const national = digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
      return `tel:+1${national}`;
    }

    function factText(listing: CompareListing, key: keyof CompareListing): string {
      const value = listing[key];
      if (value == null || value === '') return 'Not listed';
      return String(value);
    }

    document.querySelectorAll('[data-compare]').forEach((section) => {
      const root = section.closest('[data-filter-root]') ?? document;
      const summary = section.querySelector<HTMLElement>('[data-compare-summary]');
      const mount = section.querySelector<HTMLElement>('[data-compare-mount]');
      const dataNode = section.querySelector('#compare-listings');
      const catalog: CompareListing[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
      const bySlug = new Map(catalog.map((listing) => [listing.slug, listing]));
      const order: string[] = [];
      let shown = 0;

      function selected(): CompareListing[] {
        return order.flatMap((slug) => {
          const listing = bySlug.get(slug);
          return listing ? [listing] : [];
        });
      }

      function render() {
        const items = selected();
        if (summary) {
          if (catalog.length < 2) {
            summary.textContent = 'This page lists one facility, so there is no second lot to put beside it.';
          } else if (items.length === 0) {
            summary.textContent = idleSummary;
          } else if (items.length === 1) {
            summary.textContent = '1 facility checked. Select one more. Three is the most.';
          } else if (items.length === 2) {
            summary.textContent = '2 facilities. A marked row is one where they do not all say the same thing. A blank stays “Not listed.”';
          } else {
            summary.textContent = '3 facilities, which is the most. Uncheck one to swap in another. A marked row is a difference.';
          }
        }
        if (!mount) return;
        mount.replaceChildren();
        if (items.length < 2) {
          shown = items.length;
          return;
        }
        const table = document.createElement('table');
        const caption = document.createElement('caption');
        caption.textContent = 'Published facts for the facilities you checked';
        table.append(caption);
        const head = document.createElement('thead');
        const headRow = document.createElement('tr');
        const corner = document.createElement('th');
        corner.scope = 'col';
        corner.textContent = 'Fact';
        headRow.append(corner);
        for (const listing of items) {
          const th = document.createElement('th');
          th.scope = 'col';
          const link = document.createElement('a');
          link.href = `#${listing.slug}`;
          link.textContent = listing.name;
          th.append(link);
          headRow.append(th);
        }
        head.append(headRow);
        table.append(head);
        const body = document.createElement('tbody');
        for (const row of compareRows) {
          const values = items.map((listing) => factText(listing, row.key));
          const differs = new Set(values).size > 1;
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = row.label;
          if (differs) th.className = 'diff';
          tr.append(th);
          items.forEach((listing, index) => {
            const td = document.createElement('td');
            if (differs) td.className = 'diff';
            if (row.key === 'phone' && listing.phone) {
              const link = document.createElement('a');
              link.href = phoneHref(listing.phone);
              link.textContent = listing.phone;
              td.append(link);
            } else if (row.key === 'website' && listing.website) {
              const link = document.createElement('a');
              link.href = listing.website;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.textContent = 'Website';
              const note = document.createElement('span');
              note.className = 'sr-only';
              note.textContent = ` for ${listing.name} (opens in a new tab)`;
              link.append(note);
              td.append(link);
            } else {
              td.textContent = values[index];
            }
            tr.append(td);
          });
          body.append(tr);
        }
        table.append(body);
        mount.append(table);
        if (shown < 2) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        shown = items.length;
      }

      root.addEventListener('change', (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || !input.matches('[data-compare-pick]')) return;
        const slug = input.value;
        if (!bySlug.has(slug)) return;
        if (input.checked) {
          if (order.length >= 3) {
            input.checked = false;
            if (summary) summary.textContent = 'Three facilities is the limit. Uncheck one to add another.';
            return;
          }
          if (!order.includes(slug)) order.push(slug);
        } else {
          const index = order.indexOf(slug);
          if (index >= 0) order.splice(index, 1);
        }
        render();
      });

      section.querySelector('[data-compare-clear]')?.addEventListener('click', () => {
        order.splice(0, order.length);
        root.querySelectorAll<HTMLInputElement>('[data-compare-pick]').forEach((input) => {
          input.checked = false;
        });
        render();
      });

      if (catalog.length < 2) render();
    });
  </script>
</Base>
