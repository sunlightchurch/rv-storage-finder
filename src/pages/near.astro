---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { href } from '../lib/data';
import { buildSearchData } from '../lib/places.mjs';
import { priceLines } from '../lib/prices';

const searchData = buildSearchData();
for (const facility of searchData.facilities) {
  const lines = priceLines({
    storage_types: facility.storage_types || [],
    price_notes: facility.price_notes || null,
  });
  const monthly = lines.filter((line) => line.unit === 'mo').map((line) => line.amount);
  facility.monthly = monthly.length ? Math.min(...monthly) : null;
  facility.covered = (facility.storage_types || []).includes('covered');
  facility.enclosed = (facility.storage_types || []).includes('enclosed');
  facility.open = (facility.storage_types || []).includes('open');
  facility.boat = (facility.vehicles || []).includes('boat');
  delete facility.price_notes;
  delete facility.storage_types;
  delete facility.vehicles;
}

const title = 'Nearest RV and boat storage | RV Storage Prices';
const description =
  'Facilities and cities nearest a ZIP code or a city name, with distance in miles. These query results are not a separate directory entry.';
const path = '/near/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Nearest', path },
];
const dataJson = JSON.stringify(searchData).replaceAll('<', '\\u003c');
---

<Base title={title} description={description} path={path} noindex={true}>
  <link slot="head" rel="preload" as="fetch" href={href('/zcta.csv')} crossorigin="anonymous" />
  <article class="wrap prose">
    <Breadcrumbs items={crumbs} />
    <h1 id="near-title">Nearest RV and boat storage</h1>
    <p id="near-lead">Enter a ZIP code or a city name.</p>
    <div id="near-results"></div>
    <p class="fine">
      ZIP centers are 2024 Census ZIP Code Tabulation Area internal points. A distance is to that
      center, or to a facility coordinate when the listing has one. It is not a driving distance.
    </p>
  </article>
  <script id="near-data" type="application/json" set:html={dataJson} />
  <script is:inline define:vars={{ zipUrl: href('/zcta.csv') }}>
    window.__zctaText = fetch(zipUrl).then((response) => (response.ok ? response.text() : Promise.reject()));
  </script>
  <script>
    import { formatMiles, runSearch, parseZcta } from '../lib/geo.mjs';

    const params = new URLSearchParams(window.location.search);
    const query = (params.get('q') ?? '').trim();
    const title = document.getElementById('near-title');
    const lead = document.getElementById('near-lead');
    const results = document.getElementById('near-results');
    const base = import.meta.env.BASE_URL || '/';
    const raw = document.getElementById('near-data')?.textContent || '{"cities":[],"facilities":[]}';
    const data = JSON.parse(raw);

    function pageHref(urlPath: string) {
      const trimmed = urlPath.replace(/^\//, '');
      return `${base}${trimmed}`;
    }

    function cityLink(city: { id: string; label: string; path?: string }, miles: number | null) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = pageHref(city.path || `cities/${city.id}/`);
      link.textContent = city.label;
      li.append(link);
      if (miles != null) {
        const note = document.createElement('span');
        note.textContent = ` · ${formatMiles(miles)}`;
        li.append(note);
      }
      return li;
    }

    function facilityLink(row: {
      item: {
        slug: string;
        name: string;
        place: string;
        cityId: string;
        path?: string;
        approx: string | null;
        monthly?: number | null;
        covered?: boolean;
        enclosed?: boolean;
        open?: boolean;
        boat?: boolean;
      };
      miles: number;
    }) {
      const li = document.createElement('li');
      li.dataset.miles = String(row.miles);
      if (row.item.monthly != null) li.dataset.monthly = String(row.item.monthly);
      li.dataset.covered = String(Boolean(row.item.covered));
      li.dataset.enclosed = String(Boolean(row.item.enclosed));
      li.dataset.open = String(Boolean(row.item.open));
      li.dataset.boat = String(Boolean(row.item.boat));
      const link = document.createElement('a');
      const home = row.item.path || `cities/${row.item.cityId}/`;
      link.href = pageHref(`${home}#${row.item.slug}`);
      link.textContent = row.item.name;
      li.append(link);
      const note = document.createElement('span');
      const price = row.item.monthly != null ? ` · from $${row.item.monthly}/mo` : '';
      note.textContent = ` · ${row.item.place} · ${formatMiles(row.miles)}${price}`;
      li.append(note);
      return li;
    }

    function wireNearSort(list: HTMLOListElement) {
      const bar = document.createElement('div');
      bar.className = 'sortbar';
      bar.innerHTML = [
        '<label class="sort-label"><span class="sr-only">Sort</span><select data-near-sort>',
        '<option value="distance">Distance</option>',
        '<option value="price-asc">Price: low to high</option>',
        '<option value="price-desc">Price: high to low</option>',
        '</select></label>',
        '<button type="button" class="filter-open" data-near-sheet-open aria-expanded="false">Filters</button>',
      ].join('');
      const sheet = document.createElement('div');
      sheet.className = 'sheet';
      sheet.hidden = true;
      sheet.innerHTML = [
        '<div class="sheet-panel" role="dialog" aria-modal="true" aria-label="Filters">',
        '<div class="sheet-head"><h2>Filters</h2><button type="button" class="text-btn" data-near-sheet-close>Close</button></div>',
        '<div class="sheet-options">',
        '<button type="button" data-near-filter="all" aria-pressed="true">All types</button>',
        '<button type="button" data-near-filter="covered" aria-pressed="false">Covered</button>',
        '<button type="button" data-near-filter="enclosed" aria-pressed="false">Enclosed</button>',
        '<button type="button" data-near-filter="open" aria-pressed="false">Open</button>',
        '<button type="button" data-near-filter="boat" aria-pressed="false">Boat</button>',
        '</div>',
        '<button type="button" class="sheet-done" data-near-sheet-close>Show results</button>',
        '</div>',
      ].join('');
      const status = document.createElement('p');
      status.className = 'fine';
      const items = () => [...list.querySelectorAll('li')];
      items().forEach((item, index) => {
        item.dataset.order = String(index);
      });
      function paint() {
        const select = bar.querySelector('select');
        const mode = select instanceof HTMLSelectElement ? select.value : 'distance';
        const keys = [...sheet.querySelectorAll('[data-near-filter]')]
          .filter((button) => button.getAttribute('data-near-filter') !== 'all' && button.getAttribute('aria-pressed') === 'true')
          .map((button) => button.getAttribute('data-near-filter'));
        const ranked = items().sort((a, b) => {
          const orderA = Number(a.dataset.order);
          const orderB = Number(b.dataset.order);
          if (mode === 'price-asc' || mode === 'price-desc') {
            const left = a.dataset.monthly ? Number(a.dataset.monthly) : null;
            const right = b.dataset.monthly ? Number(b.dataset.monthly) : null;
            if (left == null && right == null) return orderA - orderB;
            if (left == null) return 1;
            if (right == null) return -1;
            return mode === 'price-asc' ? left - right : right - left;
          }
          return Number(a.dataset.miles) - Number(b.dataset.miles);
        });
        ranked.forEach((item) => {
          const ok = keys.every((key) => item.getAttribute(`data-${key}`) === 'true');
          item.hidden = !ok;
          list.append(item);
        });
        status.textContent = mode.startsWith('price')
          ? 'Lowest published monthly price first. Lots without a monthly price stay last.'
          : 'Nearest first.';
      }
      const open = bar.querySelector('[data-near-sheet-open]');
      const closeSheet = () => {
        sheet.hidden = true;
        open?.setAttribute('aria-expanded', 'false');
      };
      open?.addEventListener('click', () => {
        sheet.hidden = false;
        open.setAttribute('aria-expanded', 'true');
      });
      sheet.querySelectorAll('[data-near-sheet-close]').forEach((button) => {
        button.addEventListener('click', closeSheet);
      });
      sheet.addEventListener('click', (event) => {
        const button = event.target instanceof Element ? event.target.closest('[data-near-filter]') : null;
        if (!button) return;
        const filter = button.getAttribute('data-near-filter');
        if (filter === 'all') {
          sheet.querySelectorAll('[data-near-filter]').forEach((item) => {
            item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
          });
        } else {
          const next = button.getAttribute('aria-pressed') !== 'true';
          button.setAttribute('aria-pressed', next ? 'true' : 'false');
          const any = [...sheet.querySelectorAll('[data-near-filter]')].some(
            (item) => item.getAttribute('data-near-filter') !== 'all' && item.getAttribute('aria-pressed') === 'true',
          );
          const all = sheet.querySelector('[data-near-filter="all"]');
          if (all) all.setAttribute('aria-pressed', any ? 'false' : 'true');
        }
        paint();
      });
      bar.querySelector('select')?.addEventListener('change', paint);
      list.before(bar, sheet, status);
    }

    function section(heading: string, items: HTMLElement[], sortable = false) {
      if (!items.length || !results) return;
      const h2 = document.createElement('h2');
      h2.textContent = heading;
      const list = document.createElement('ol');
      list.className = 'near-list';
      items.forEach((item) => list.append(item));
      results.append(h2, list);
      if (sortable) wireNearSort(list);
    }

    async function show() {
      if (!title || !lead || !results) return;
      if (!query) {
        title.textContent = 'Search by ZIP or city';
        lead.textContent = 'Type a ZIP code or a city name, then press Search or the keyboard Go key.';
        return;
      }
      const csv = await (window.__zctaText || fetch(pageHref('zcta.csv')).then((response) => response.text()));
      if (!csv) {
        title.textContent = 'Search is unavailable';
        lead.textContent = 'The ZIP center list did not load. Open a state page and pick a city.';
        return;
      }
      const found = runSearch(query, data, parseZcta(csv));
      if (found.kind === 'city' && found.redirect) {
        window.location.replace(pageHref(found.redirect.path || `cities/${found.redirect.id}/`));
        return;
      }
      if (found.kind === 'zip' && !found.known) {
        title.textContent = 'ZIP not in the Census list';
        lead.textContent = `There is no center point for ${found.zip}. Try a nearby ZIP or a city name.`;
        return;
      }
      if (found.kind === 'zip') {
        lead.textContent = found.outside
          ? `ZIP ${found.zip} is outside the cities in this directory. These are the closest facilities we list, in miles.`
          : `Facilities near ${found.zip}, in miles.`;
        if (found.how === 'prefix') {
          lead.textContent += ` ${found.zip} has no area of its own, so the start point is a nearby ZIP.`;
        }
        section(
          'Facilities',
          found.facilities.map((row) => facilityLink(row)),
          true,
        );
        section(
          'Cities',
          found.cities.map((row) => cityLink(row.item, row.miles)),
        );
        return;
      }
      title.textContent = found.matches.length ? `Cities matching “${query}”` : 'No matching city';
      lead.textContent = found.matches.length
        ? 'More than one place fits. Open a city for its facilities.'
        : 'That city is not in this directory. Try the full name, or a ZIP code for the nearest facilities we list.';
      section(
        'Cities',
        found.matches.map((city) => cityLink(city, null)),
      );
      section(
        'Facilities',
        found.facilities.map((facility) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = pageHref(`${facility.path || `cities/${facility.cityId}/`}#${facility.slug}`);
          link.textContent = facility.name;
          li.append(link);
          const note = document.createElement('span');
          note.textContent = ` · ${facility.place}`;
          li.append(note);
          return li;
        }),
      );
    }

    show();
  </script>
</Base>
