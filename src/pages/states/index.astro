---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardPhoto from '../../components/CardPhoto.astro';
import { cityStats, countiesInState, directoryStats, getStates, href } from '../../lib/data';
import { locationCount } from '../../lib/format';
import { getPhoto } from '../../lib/photos';
import { medianOf } from '../../lib/guides';
import { statePhoto } from '../../lib/photos';
import { formatMoney, formatMonthlyRange, monthlySpan, parsePriceNote } from '../../lib/prices';
import { breadcrumbNode, pageGraph, webPageNode } from '../../lib/schema';

function lowestMonthly(listings: { price_notes: string | null }[]): number[] {
  const amounts: number[] = [];
  for (const listing of listings) {
    const values = parsePriceNote(listing.price_notes).monthly;
    if (values.length) amounts.push(Math.min(...values));
  }
  return amounts;
}

const rows = getStates().map((state) => {
  const hubs = countiesInState(state.code);
  const facilityCount =
    state.cities.reduce((sum, city) => sum + city.listings.length, 0) +
    hubs.reduce((sum, county) => sum + county.listings.length, 0);
  const amounts = [
    ...state.cities.flatMap((city) => lowestMonthly(city.listings)),
    ...hubs.flatMap((county) => lowestMonthly(county.listings)),
  ];
  return {
    state,
    hubs,
    facilityCount,
    span: monthlySpan(amounts.map((amount) => [amount])),
    median: amounts.length ? medianOf(amounts) : null,
    photo: statePhoto(state.slug),
  };
});
const title = 'Browse RV storage by state | RV Storage Prices';
const description =
  'Pick a state, then a city. Each card shows a facility count and a price range only when facilities published a monthly amount.';
const path = '/states/';
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'States', path },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: directoryStats().latest }),
  breadcrumbNode(crumbs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Browse by state</h1>
    <p class="summary">
      Each state card uses a place photo and the monthly amounts facilities actually printed. A state
      with no monthly amount does not get a made-up range. Open a city for the facilities.
      <a href={href('/costs/')}>Sort cities by median price</a>.
    </p>
    {
      rows.map(({ state, hubs, facilityCount, span, median, photo }) => (
        <article class="state-directory">
          <a class="state-card" href={href(`/states/${state.slug}/`)}>
            <CardPhoto photo={photo} sizes="(min-width: 1024px) 420px, 100vw" />
            <span class="state-card-copy">
              <span class="eyebrow">{state.code}</span>
              <span class="state-card-name">{state.name}</span>
              <span class="city-meta">{locationCount(facilityCount)}</span>
              <span class="city-meta">
                {span.low != null && span.high != null
                  ? `Published monthly ${formatMonthlyRange(span.low, span.high)}`
                  : 'No monthly price'}
              </span>
              {median != null && <span class="city-meta">From {formatMoney(median)}/mo median</span>}
            </span>
          </a>
          <ul class="place-grid card-grid">
            {state.cities.map((city) => {
              const amounts = lowestMonthly(city.listings);
              const cityMedian = amounts.length ? medianOf(amounts) : null;
              return (
                <li>
                  <a class="place-link" href={href(`/cities/${city.id}/`)}>
                    <CardPhoto photo={getPhoto(city.photo)} />
                    <span class="city-name">{city.city}, {city.state_code}</span>
                    <span class="city-meta">{locationCount(cityStats(city).total)}</span>
                    <span class="city-meta">
                      {cityMedian != null ? `From ${formatMoney(cityMedian)}/mo median` : 'No monthly price'}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
          {
            hubs.length > 0 && (
              <ul class="jump">
                {hubs.map((county) => (
                  <li>
                    <a href={href(`/states/${state.slug}/${county.id}/`)}>
                      {county.name}
                      <span class="count">{locationCount(county.listings.length)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </article>
      ))
    }
    <p class="legend">
      State photos show the place, not a storage lot. <a href={href('/credits/')}>Photo credits</a>.
    </p>
  </div>
</Base>
