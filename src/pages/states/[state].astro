---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FindMore from '../../components/FindMore.astro';
import { absolute, cityStats, getState, getStates, href } from '../../lib/data';
import { getPhoto, statePhoto } from '../../lib/photos';
import Photo from '../../components/Photo.astro';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';

export function getStaticPaths() {
  return getStates().map((state) => ({ params: { state: state.slug } }));
}

const state = getState(Astro.params.state!);
const ruleNote = {
  FL: {
    path: '/rules/florida/',
    label: 'Florida HOA notes for an RV or boat on a parcel',
    detail: 'quote section 720.3045.',
  },
  NV: {
    path: '/rules/nevada/',
    label: 'Nevada HOA notes for an RV or boat',
    detail: 'quote NRS 116.350.',
  },
  AZ: {
    path: '/rules/arizona/',
    label: 'Arizona HOA notes for an RV or boat',
    detail: 'say no RV or boat parking statute was found.',
  },
  TX: {
    path: '/rules/texas/',
    label: 'Texas HOA notes for an RV or boat',
    detail: 'quote Property Code section 209.015.',
  },
  GA: {
    path: '/rules/georgia/',
    label: 'Georgia HOA notes for an RV or boat',
    detail: 'say no RV or boat parking statute was found.',
  },
  NC: {
    path: '/rules/north-carolina/',
    label: 'North Carolina HOA notes for an RV or boat',
    detail: 'quote Chapter 47F, which does not name an RV or a boat.',
  },
}[state.code];
const path = `/states/${state.slug}/`;
const total = state.cities.reduce((sum, city) => sum + city.listings.length, 0);
const names = state.cities.map((city) => city.city);
const shortList = names.length <= 3 ? names.join(' and ') : `${names.slice(0, 2).join(', ')} and ${names.length - 2} more`;
const title = `RV and boat storage in ${state.name} | RV Storage Prices`;
const description = `${total} sourced RV and boat storage facilities in ${shortList}, ${state.code}, plus nearby communities on each city page.`;
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'States', path: '/states/' },
  { label: state.name, path },
];
const faqs = [
  {
    q: `Which ${state.name} cities have RV and boat storage listings?`,
    a: `${state.cities.map((city) => `${city.city} (${city.listings.length} facilities)`).join('; ')}. A facility keeps the city printed on its own page, which may be a suburb of that metro.`,
  },
];
const latest = state.cities
  .flatMap((city) => city.listings.map((listing) => listing.last_verified))
  .sort()
  .at(-1);
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: latest }),
  breadcrumbNode(crumbs),
  {
    '@type': 'ItemList',
    name: `RV and boat storage in ${state.name}`,
    numberOfItems: state.cities.length,
    itemListElement: state.cities.map((city, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${city.city}, ${city.state_code}`,
      url: absolute(`/cities/${city.id}/`),
    })),
  },
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <Photo photo={statePhoto(state.slug)} sizes="(min-width: 900px) 1100px, 100vw" eager />
    <h1>RV and boat storage in {state.name}</h1>
    <p class="summary">
      {total} facilities across {state.cities.length === 1 ? 'one metro' : `${state.cities.length} metros`}.
      Open a city for cover type, length, power, and prices that the facility actually published.
    </p>
    <ul class="city-grid">
      {
        state.cities.map((city) => {
          const counts = cityStats(city);
          return (
            <li>
              <a class="city-card" href={href(`/cities/${city.id}/`)}>
                <img
                  src={href(`/${getPhoto(city.photo).files['640']}`)}
                  alt=""
                  width={getPhoto(city.photo).width}
                  height={getPhoto(city.photo).height}
                  loading="lazy"
                  decoding="async"
                />
                <span class="city-name">{city.city}, {city.state_code}</span>
                <span class="city-meta">
                  {counts.total} facilities · {counts.covered} list covered space
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    {
      state.cities.map((city) => (
        <section>
          <h2>{city.city}, {city.state_code}</h2>
          <p>{city.summary}</p>
          <p>
            <a href={href(`/cities/${city.id}/`)}>All {city.city}, {city.state_code} listings</a>
            {' · '}
            <a href={href(`/costs/${city.id}/`)}>Monthly prices</a>
          </p>
          <FindMore city={city} />
        </section>
      ))
    }
    {
      ruleNote && (
        <p>
          <a href={href(ruleNote.path)}>{ruleNote.label}</a> {ruleNote.detail} They are not legal
          advice, and they are separate from these storage lots.
        </p>
      )
    }
    <section class="faq">
      <h2>Questions</h2>
      {
        faqs.map((faq) => (
          <>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </>
        ))
      }
    </section>
  </div>
</Base>
