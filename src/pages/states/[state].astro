---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardPhoto from '../../components/CardPhoto.astro';
import FindMore from '../../components/FindMore.astro';
import Photo from '../../components/Photo.astro';
import ResultMap from '../../components/ResultMap.astro';
import { absolute, countiesInState, countyPath, getState, getStates, href, type Listing } from '../../lib/data';
import { placeDescription } from '../../lib/seo';
import { getPhoto, statePhoto } from '../../lib/photos';
import { parsePriceNote } from '../../lib/prices';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../../lib/schema';
import { normalizeZip, zipCentroids } from '../../lib/zips';

export function getStaticPaths() {
  return getStates().map((state) => ({ params: { state: state.slug } }));
}

const state = getState(Astro.params.state!);
const ruleNote = {
  FL: {
    path: '/rules/florida/',
    label: 'Florida HOA notes for an RV or boat on a parcel',
    detail: 'quote section 720.3045.',
  },
  NV: {
    path: '/rules/nevada/',
    label: 'Nevada HOA notes for an RV or boat',
    detail: 'quote NRS 116.350.',
  },
  AZ: {
    path: '/rules/arizona/',
    label: 'Arizona HOA notes for an RV or boat',
    detail: 'say no RV or boat parking statute was found.',
  },
  TX: {
    path: '/rules/texas/',
    label: 'Texas HOA notes for an RV or boat',
    detail: 'quote Property Code section 209.015.',
  },
  GA: {
    path: '/rules/georgia/',
    label: 'Georgia HOA notes for an RV or boat',
    detail: 'say no RV or boat parking statute was found.',
  },
  NC: {
    path: '/rules/north-carolina/',
    label: 'North Carolina HOA notes for an RV or boat',
    detail: 'quote Chapter 47F, which does not name an RV or a boat.',
  },
}[state.code];
const path = `/states/${state.slug}/`;
const hubs = countiesInState(state.code);
const total = state.cities.reduce((sum, city) => sum + city.listings.length, 0);
const hubTotal = hubs.reduce((sum, county) => sum + county.listings.length, 0);
const stateListings = [
  ...state.cities.flatMap((city) => city.listings),
  ...hubs.flatMap((county) => county.listings),
];
const stateHasBoat = stateListings.some((listing) => listing.vehicles.includes('boat'));
const title = stateHasBoat ? `RV & Boat Storage in ${state.name}` : `RV Storage in ${state.name}`;
const description = placeDescription(state.name, stateListings);
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'States', path: '/states/' },
  { label: state.name, path },
];
const faqs = [
  {
    q: `Which ${state.name} cities have RV and boat storage listings?`,
    a: `${state.cities.map((city) => `${city.city} (${city.listings.length} facilities)`).join('; ')}.${hubs.length ? ` Smaller towns are on ${hubs.map((county) => `${county.name} (${county.listings.length})`).join('; ')}.` : ''} A facility keeps the city printed on its own page.`,
  },
];
const latest = state.cities
  .flatMap((city) => city.listings.map((listing) => listing.last_verified))
  .sort()
  .at(-1);
function facilityCount(count: number): string {
  return count === 1 ? '1 facility' : `${count} facilities`;
}
function lowestMonthly(listings: Listing[]): number | null {
  const amounts: number[] = [];
  for (const listing of listings) {
    const values = parsePriceNote(listing.price_notes).monthly;
    if (values.length) amounts.push(Math.min(...values));
  }
  return amounts.length ? Math.min(...amounts) : null;
}
function placePoint(listings: Listing[]): { lat: number; lng: number; approx: 'exact' | 'zip' } | null {
  const exact = listings.filter((listing) => listing.lat != null && listing.lng != null);
  if (exact.length) {
    return {
      lat: exact.reduce((sum, listing) => sum + (listing.lat as number), 0) / exact.length,
      lng: exact.reduce((sum, listing) => sum + (listing.lng as number), 0) / exact.length,
      approx: 'exact',
    };
  }
  const centroids = zipCentroids();
  const points = listings.flatMap((listing) => {
    const zip = normalizeZip(listing.postal_code);
    const point = zip ? centroids[zip] : undefined;
    return point ? [point] : [];
  });
  if (!points.length) return null;
  return {
    lat: points.reduce((sum, point) => sum + point.lat, 0) / points.length,
    lng: points.reduce((sum, point) => sum + point.lng, 0) / points.length,
    approx: 'zip',
  };
}
const places = (state.cities.length ? state.cities.map((city) => ({
  id: `city-${city.id}`,
  name: `${city.city}, ${city.state_code}`,
  path: `/cities/${city.id}/`,
  listings: city.listings,
  photo: city.photo,
})) : hubs.map((county) => ({
  id: `county-${county.id}`,
  name: `${county.name}, ${county.state_code}`,
  path: countyPath(county),
  listings: county.listings,
  photo: county.photo,
})));
const stateMapPoints = places.flatMap((place) => {
  const point = placePoint(place.listings);
  if (!point) return [];
  return [{
    id: place.id,
    name: place.name,
    lat: point.lat,
    lng: point.lng,
    price: lowestMonthly(place.listings),
    approx: point.approx,
  }];
});
const stateMapJson = JSON.stringify(stateMapPoints).replaceAll('<', '\\u003c');
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: latest }),
  breadcrumbNode(crumbs),
  {
    '@type': 'ItemList',
    name: `RV and boat storage in ${state.name}`,
      numberOfItems: state.cities.length + hubs.length,
    itemListElement: [
      ...state.cities.map((city, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${city.city}, ${city.state_code}`,
        url: absolute(`/cities/${city.id}/`),
      })),
      ...hubs.map((county, index) => ({
        '@type': 'ListItem',
        position: state.cities.length + index + 1,
        name: `${county.name}, ${county.state_code}`,
        url: absolute(countyPath(county)),
      })),
    ],
  },
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <Photo photo={statePhoto(state.slug)} sizes="(min-width: 900px) 1100px, 100vw" eager />
    <h1>RV and boat storage in {state.name}</h1>
    <p class="summary">
      {total + hubTotal} facilities
      {state.cities.length > 0
        ? ` across ${state.cities.length === 1 ? 'one metro' : `${state.cities.length} metros`}`
        : ' on county pages'}.
      {state.cities.length > 0 && hubTotal > 0 ? ` ${hubTotal} more are on county pages for towns outside those metros.` : ''}
      A pin price is the lowest monthly amount a facility in that place published.
    </p>
    <form class="state-search home-search" role="search" action={href('/near/')} method="get">
      <label class="sr-only" for={`${state.slug}-q`}>City, ZIP or state</label>
      <input
        id={`${state.slug}-q`}
        name="q"
        data-city-search
        type="search"
        role="combobox"
        placeholder="City, ZIP or state"
        autocomplete="off"
        aria-autocomplete="list"
        aria-controls={`${state.slug}-q-results`}
        aria-expanded="false"
      />
      <ul id={`${state.slug}-q-results`} class="search-results" role="listbox" hidden></ul>
    </form>
    <ResultMap>
      <ul class="map-places">
        {
          places.map((place) => (
            <li>
              <a class="city-card" id={place.id} href={href(place.path)}>
                {place.photo && <CardPhoto photo={getPhoto(place.photo)} />}
                <span class="city-name">{place.name}</span>
                <span class="city-meta">{facilityCount(place.listings.length)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <script slot="points" id="map-points" type="application/json" set:html={stateMapJson} />
    </ResultMap>
    {
      hubs.length > 0 && (
        <section>
          <h2>County pages</h2>
          <p>
            A town with fewer facilities has its own county page, including a page that lists a single
            lot. The town on the card is the one printed by the facility.
          </p>
          <ul>
            {hubs.map((county) => (
              <li>
                <a href={href(countyPath(county))}>{county.name}</a>
                {' · '}
                {county.listings.length} {county.listings.length === 1 ? 'facility' : 'facilities'}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      state.cities.map((city) => (
        <section>
          <h2>{city.city}, {city.state_code}</h2>
          <p>{city.summary}</p>
          <p>
            <a href={href(`/cities/${city.id}/`)}>All {city.city}, {city.state_code} listings</a>
            {' · '}
            <a href={href(`/costs/${city.id}/`)}>Monthly prices</a>
          </p>
          <FindMore city={city} />
        </section>
      ))
    }
    {
      ruleNote && (
        <p>
          <a href={href(ruleNote.path)}>{ruleNote.label}</a> {ruleNote.detail} They are not legal
          advice, and they are separate from these storage lots.
        </p>
      )
    }
    <section class="faq">
      <h2>Questions</h2>
      {
        faqs.map((faq) => (
          <>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </>
        ))
      }
    </section>
  </div>
</Base>
