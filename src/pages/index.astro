---
import Base from '../layouts/Base.astro';
import CardPhoto from '../components/CardPhoto.astro';
import CitySearch from '../components/CitySearch.astro';
import FindMore from '../components/FindMore.astro';
import { absolute, cityStats, countiesInState, directoryStats, getStates, href, site } from '../lib/data';
import { locationCount } from '../lib/format';
import { medianOf } from '../lib/guides';
import { heroPhoto, getPhoto, statePhoto } from '../lib/photos';
import { formatMoney, formatMonthlyRange, monthlyByCover, monthlySpan, parsePriceNote } from '../lib/prices';
import { breadcrumbNode, faqNode, pageGraph, webPageNode } from '../lib/schema';

const states = getStates();
const cities = states.flatMap((state) => state.cities);
const stats = directoryStats();
const hero = heroPhoto();

function lowestMonthly(listings: { price_notes: string | null; storage_types: readonly string[] }[]) {
  const amounts: number[] = [];
  for (const listing of listings) {
    const values = parsePriceNote(listing.price_notes).monthly;
    if (values.length) amounts.push(Math.min(...values));
  }
  return amounts;
}

const popular = cities
  .map((city) => {
    const amounts = lowestMonthly(city.listings);
    return { city, amounts, span: monthlySpan(amounts.map((amount) => [amount])) };
  })
  .filter((row) => row.amounts.length > 0)
  .sort((a, b) => b.amounts.length - a.amounts.length || a.city.city.localeCompare(b.city.city))
  .slice(0, 4);
const spotlight = popular.slice(0, 3);

const coverBuckets = { open: [] as number[][], covered: [] as number[][] };
for (const city of cities) {
  for (const listing of city.listings) {
    const byType = monthlyByCover(listing);
    if (byType.open.length) coverBuckets.open.push(byType.open);
    if (byType.covered.length) coverBuckets.covered.push(byType.covered);
  }
}
const openSpan = monthlySpan(coverBuckets.open);
const coveredSpan = monthlySpan(coverBuckets.covered);
const focusSlugs = ['florida', 'arizona', 'texas', 'georgia', 'nevada', 'north-carolina'];
const featured = focusSlugs.flatMap((slug) => {
  const state = states.find((item) => item.slug === slug);
  if (!state) return [];
  const hubs = countiesInState(state.code);
  const listings = [...state.cities.flatMap((city) => city.listings), ...hubs.flatMap((county) => county.listings)];
  const amounts = lowestMonthly(listings);
  return [{
    state,
    listings: listings.length,
    boats: listings.filter((listing) => listing.vehicles.includes('boat')).length,
    median: amounts.length ? medianOf(amounts) : null,
    photo: statePhoto(state.slug),
  }];
});
const boatTotal = featured.reduce((sum, row) => sum + row.boats, 0);
const featuredCityIds = [
  'tampa-fl',
  'orlando-fl',
  'miami-fl',
  'jacksonville-fl',
  'phoenix-az',
  'tucson-az',
  'houston-tx',
  'dallas-fort-worth-tx',
  'austin-tx',
  'san-antonio-tx',
  'atlanta-ga',
  'las-vegas-nv',
  'charlotte-nc',
  'raleigh-nc',
];
const featuredCities = featuredCityIds.flatMap((id) => {
  const city = cities.find((item) => item.id === id);
  if (!city) return [];
  return [{
    city,
    rv: city.listings.some((listing) => listing.vehicles.includes('rv')),
    boat: city.listings.some((listing) => listing.vehicles.includes('boat')),
  }];
});
const title = 'RV and boat storage by city | RV Storage Prices';
const description =
  'Search sourced RV and boat storage by city or ZIP. Cover type, power, and monthly prices appear only when a facility publishes them.';
const path = '/';
const cityNames = states
  .map((state) => `${state.name} (${state.cities.map((city) => city.city).join(', ')})`)
  .join('; ');
const faqs = [
  {
    q: 'Which cities are in this directory?',
    a: `Pages currently cover ${cityNames}. County pages list smaller towns that are not on a city page. A facility keeps the city printed on its own page, which may be a suburb.`,
  },
  {
    q: 'Why does a listing say not listed?',
    a: 'Not listed means the public page we checked did not state that fact. It does not mean the facility lacks the amenity. Yes means the source says it is available. No means the source says it is not.',
  },
  {
    q: 'Do facilities pay to be listed?',
    a: 'No. A listing is added from a public source such as the facility website. Neighbor and SpareFoot links are separate commercial links and are labeled as such.',
  },
];
const schema = pageGraph([
  webPageNode({ title, description, path, dateModified: stats.latest }),
  {
    '@type': 'WebSite',
    name: site.name,
    url: absolute('/'),
    description: site.description,
  },
  breadcrumbNode([{ label: 'Home', path }]),
  {
    '@type': 'ItemList',
    name: 'RV and boat storage cities',
    numberOfItems: cities.length,
    itemListElement: cities.map((city, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${city.city}, ${city.state_code}`,
      url: absolute(`/cities/${city.id}/`),
    })),
  },
  faqNode(faqs),
]);
---

<Base title={title} description={description} path={path} schema={schema}>
  <section class="find-hero">
    <div class="wrap">
      <p class="eyebrow">RV and boat storage</p>
      <h1>RV &amp; boat storage, priced in the open.</h1>
      <p class="lede">Every price is copied from the facility’s own page.</p>
      <form class="find-bar home-search" role="search" action={href('/near/')} method="get">
        <label class="sr-only" for="home-q">City, ZIP or state</label>
        <input
          id="home-q"
          name="q"
          data-city-search
          type="search"
          role="combobox"
          placeholder="City, ZIP or state"
          autocomplete="off"
          aria-autocomplete="list"
          aria-controls="home-q-results"
          aria-expanded="false"
          required
        />
        <label class="sr-only" for="home-type">What are you storing</label>
        <select id="home-type" name="type">
          <option value="">Any storage</option>
          <option value="rv">RV storage</option>
          <option value="boat">Boat storage</option>
          <option value="trailer">Trailer storage</option>
          <option value="covered">Covered</option>
          <option value="enclosed">Enclosed</option>
          <option value="indoor">Indoor</option>
        </select>
        <button type="submit">Find storage</button>
        <ul id="home-q-results" class="search-results" role="listbox" hidden></ul>
      </form>
      <p class="find-trust">
        {stats.facilities.toLocaleString('en-US')} facilities · {stats.states} states · prices from facility pages
      </p>
    </div>
  </section>
  <div class="wrap">
    <section class="how">
      <h2>How it works</h2>
      <ol class="how-steps">
        <li>
          <span class="step-no">1</span>
          <strong>Search a place</strong>
          <span>A city, a ZIP, or a state. The list is the facilities we have sourced.</span>
        </li>
        <li>
          <span class="step-no">2</span>
          <strong>Compare what they printed</strong>
          <span>Price, cover, and length stay blank when the facility page did not say them.</span>
        </li>
        <li>
          <span class="step-no">3</span>
          <strong>Call the facility</strong>
          <span>The card is a copy of a public page. The lot confirms whether a space is open.</span>
        </li>
      </ol>
    </section>
    <section class="featured-cities">
      <h2>Featured cities</h2>
      <p class="lede">RV storage and boat storage, only where a facility lists that vehicle.</p>
      <ul>
        {
          featuredCities.map(({ city, rv, boat }) => (
            <li>
              <a class="featured-name" href={href(`/cities/${city.id}/`)}>{city.city}, {city.state_code}</a>
              {rv && <a href={`${href(`/cities/${city.id}/`)}?type=rv`}>RV storage</a>}
              {boat && <a href={`${href(`/cities/${city.id}/`)}?type=boat`}>Boat storage</a>}
            </li>
          ))
        }
      </ul>
    </section>
    <section class="compare-band">
      <h2>How the published medians compare</h2>
      <ul class="median-row">
        {
          featured.map(({ state, median }) => (
            <li>
              <a href={href(`/states/${state.slug}/`)}>{state.name}</a>
              <strong>{median != null ? `${formatMoney(median)}/mo` : 'No monthly price'}</strong>
            </li>
          ))
        }
      </ul>
      <p class="legend">
        Covered lots that named a roof and a month
        {coveredSpan.low != null && coveredSpan.high != null
          ? ` run ${formatMonthlyRange(coveredSpan.low, coveredSpan.high)}`
          : ' do not have a published range yet'}
        {openSpan.low != null && openSpan.high != null
          ? `, and open lots run ${formatMonthlyRange(openSpan.low, openSpan.high)}`
          : ''}
        . <a href={href('/guides/covered-vs-uncovered-vs-indoor/')}>Covered, uncovered, and indoor</a>
      </p>
    </section>
    <aside class="boat-callout">
      <p class="eyebrow">Boat storage</p>
      <h2>A boat is listed only where the facility says so</h2>
      <p>
        {boatTotal} locations in these six states list boat storage. The page for each state links the
        cities that do.
      </p>
      <p><a href={href('/boat-storage/')}>Boat storage by state</a></p>
    </aside>
    {
      popular.length > 0 && (
        <section>
          <h2>Cities with the most published prices</h2>
          <ul class="place-grid">
            {popular.map(({ city, span, amounts }) => (
              <li>
                <a class="place-link" href={href(`/cities/${city.id}/`)}>
                  <span class="city-name">{city.city}, {city.state_code}</span>
                  <span class="city-meta">{locationCount(cityStats(city).total)}</span>
                  <span class="city-meta">
                    {span.low != null && span.high != null
                      ? `From ${formatMoney(medianOf(amounts))}/mo median`
                      : 'No monthly price'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="choice-strip">
      <h2>Covered or open</h2>
      <p>
        Covered means a roof. Open means an outdoor lot. Use the type filter on a city page. The
        published ranges on lots that named the cover and a month
        {coveredSpan.low != null && coveredSpan.high != null
          ? ` run ${formatMonthlyRange(coveredSpan.low, coveredSpan.high)} for covered`
          : ' do not include a covered range yet'}
        {openSpan.low != null && openSpan.high != null
          ? ` and ${formatMonthlyRange(openSpan.low, openSpan.high)} for open`
          : ''}
        .
      </p>
      <p>
        <a href={href('/guides/covered-vs-uncovered-vs-indoor/')}>Covered, uncovered, and indoor compared</a>
      </p>
    </section>
    <h2><a href={href('/states/')}>Browse by state</a></h2>
    {
      states.map((state) => (
        <section class="state-block">
          <h3>
            <a href={href(`/states/${state.slug}/`)}>{state.name}</a>
          </h3>
          <ul class="city-grid card-grid">
            {state.cities.map((city) => {
              const counts = cityStats(city);
              const photo = getPhoto(city.photo);
              return (
                <li>
                  <a class="city-card" href={href(`/cities/${city.id}/`)}>
                    <CardPhoto photo={photo} />
                    <span class="city-card-body">
                      <span class="city-name">{city.city}, {city.state_code}</span>
                      <span class="city-meta">
                        {locationCount(counts.total)} · {counts.priced === 1 ? '1 with a monthly price' : `${counts.priced} with a monthly price`}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <p class="legend">
      Photos show the city or state, not a storage lot. <a href={href('/credits/')}>Photo credits</a>.
    </p>
    <p><a href={href('/guide/')}>How to choose storage and what it costs</a></p>
    <section class="faq prose">
      <h2>Questions</h2>
      {
        faqs.map((faq) => (
          <>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </>
        ))
      }
    </section>
    <FindMore />
  </div>
</Base>
