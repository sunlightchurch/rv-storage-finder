---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { absolute, site } from '../lib/data';
import { jsonLdScript } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown> | null;
  noindex?: boolean;
}

const { title, description, path, schema = null, noindex = false } = Astro.props;
const canonical = absolute(path);
const robots = noindex ? 'noindex, follow' : 'index, follow';
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="G_BzY6Ui0LlkM3APTiLfoREZcGa0tpmbySp5zgKFWOo" />
    <meta name="google-site-verification" content="KFCsLeWMnHirtXdgs6bnImhcAWc6h-9Ha9aFxd15FD0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0c5c56" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c3c39" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && <script type="application/ld+json" set:html={jsonLdScript(schema)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script src={`${import.meta.env.BASE_URL}search.js`} defer></script>
  </body>
</html>
