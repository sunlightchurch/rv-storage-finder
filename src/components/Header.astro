---
import { href, searchIndex, site } from '../lib/data';

const pathname = Astro.url.pathname;
const home = pathname === '/' || pathname === href('/');
const statesNav = pathname.startsWith(href('/states/'));
const guides = pathname.startsWith(href('/guide/'));
const prices = pathname.startsWith(href('/costs/'));
const about = pathname.startsWith(href('/about/')) || pathname.startsWith(href('/credits/'));
const contact = pathname.startsWith(href('/contact/'));
const index = searchIndex();
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href('/')}>
      <svg class="mark" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#1c1712"></rect>
        <path d="M7 17.2c4.4-5.6 13.6-5.6 18 0" fill="none" stroke="#e4c48a" stroke-width="1.6" stroke-linecap="round"></path>
        <path d="M8.2 17.2h15.6" fill="none" stroke="#f6f1e7" stroke-width="1.35" stroke-linecap="round"></path>
        <path d="M11.2 17.2c1.5 2.8 2.1 4 4.8 4s3.3-1.2 4.8-4" fill="none" stroke="#e4c48a" stroke-width="1.35" stroke-linecap="round"></path>
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="header-actions">
      {
        !home && (
          <button type="button" class="icon-btn" data-search-toggle aria-expanded="false" aria-controls="header-search">
            <span class="sr-only">Search</span>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
              <path d="M16 16.5L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>
        )
      }
      <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Menu</span>
        <span class="nav-bars" aria-hidden="true"></span>
      </button>
    </div>
    {
      !home && (
        <form id="header-search" class="header-search" role="search" action={href('/near/')} method="get">
          <label class="sr-only" for="header-q">Search cities or ZIP codes</label>
          <div class="search-row">
            <input
              id="header-q"
              name="q"
              data-city-search
              type="search"
              role="combobox"
              inputmode="search"
              placeholder="City or ZIP"
              autocomplete="off"
              aria-autocomplete="list"
              aria-controls="header-results"
              aria-expanded="false"
              enterkeyhint="search"
              required
            />
            <button type="submit">Search</button>
          </div>
          <ul id="header-results" class="search-results" role="listbox" hidden></ul>
        </form>
      )
    }
    <nav id="site-nav" aria-label="Primary">
      <ul>
        <li><a href={href('/states/')} aria-current={statesNav ? 'page' : undefined}>States</a></li>
        <li><a href={href('/guides/')} aria-current={guides ? 'page' : undefined}>Guides</a></li>
        <li><a href={href('/costs/')} aria-current={prices ? 'page' : undefined}>Prices</a></li>
        <li><a href={href('/about/')} aria-current={about ? 'page' : undefined}>About</a></li>
        <li><a href={href('/contact/')} aria-current={contact ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
  </div>
  <script id="city-index" type="application/json" set:html={JSON.stringify(index)} />
</header>
