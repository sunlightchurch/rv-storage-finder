---
import { href, searchIndex } from '../lib/data';

const pathname = Astro.url.pathname;
const guide = pathname.startsWith(href('/guide/'));
const about = pathname.startsWith(href('/about/')) || pathname.startsWith(href('/credits/'));
const index = searchIndex();
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href('/')}>
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#f4e7cb"></rect>
        <path fill="#0c5c56" d="M5 21h22v2.2H5z"></path>
        <path fill="none" stroke="#0c5c56" stroke-width="2" stroke-linejoin="round" d="M7 21V13h9l3 4h6v4"></path>
        <circle cx="11" cy="23.5" r="2.1" fill="#0c5c56"></circle>
        <circle cx="22" cy="23.5" r="2.1" fill="#0c5c56"></circle>
      </svg>
      <span class="brand-name">RV Storage Finder</span>
    </a>
    <form class="header-search" role="search">
      <label class="sr-only" for="header-q">Search cities or ZIP codes</label>
      <input
        id="header-q"
        data-city-search
        type="search"
        placeholder="City or ZIP"
        autocomplete="off"
        aria-controls="header-results"
        aria-expanded="false"
        enterkeyhint="search"
      />
      <ul id="header-results" class="search-results" role="listbox" hidden></ul>
    </form>
    <nav aria-label="Primary">
      <ul>
        <li><a href={href('/guide/')} aria-current={guide ? 'page' : undefined}>Cost guide</a></li>
        <li><a href={href('/about/')} aria-current={about ? 'page' : undefined}>About</a></li>
      </ul>
    </nav>
  </div>
  <script id="city-index" type="application/json" set:html={JSON.stringify(index)} />
</header>
