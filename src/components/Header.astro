---
import { getStates, href, searchIndex, site } from '../lib/data';
import Mark from './Mark.astro';

const pathname = Astro.url.pathname;
const index = searchIndex();
const states = getStates();
const focus = ['florida', 'arizona', 'texas', 'georgia', 'nevada', 'north-carolina'];
const orderedStates = [...states].sort((a, b) => {
  const rank = (slug: string) => {
    const place = focus.indexOf(slug);
    return place === -1 ? 50 : place;
  };
  return rank(a.slug) - rank(b.slug) || a.name.localeCompare(b.name);
});
const topIn = (state: (typeof orderedStates)[number]) =>
  [...state.cities].sort((a, b) => b.listings.length - a.listings.length || a.city.localeCompare(b.city)).slice(0, 4);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href('/')}>
      <Mark size={32} />
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="header-actions">
      <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Menu</span>
        <span class="nav-bars" aria-hidden="true"></span>
      </button>
    </div>
    <nav id="site-nav" aria-label="Primary">
      <div class="menu" data-menu>
        <button type="button" aria-expanded="false" aria-controls="menu-find">Find storage <span aria-hidden="true">▾</span></button>
        <div id="menu-find" class="mega" data-menu-panel hidden>
          {
            orderedStates.map((state) => (
              <div class="mega-state">
                <a class="mega-state-name" href={href(`/states/${state.slug}/`)}>{state.name}</a>
                <ul>
                  {topIn(state).map((city) => (
                    <li><a href={href(`/cities/${city.id}/`)}>{city.city}</a></li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="menu" data-menu>
        <button type="button" aria-expanded="false" aria-controls="menu-types">Storage types <span aria-hidden="true">▾</span></button>
        <div id="menu-types" data-menu-panel hidden>
          <ul>
            <li><a href={href('/storage/')}>All storage types</a></li>
            <li><a href={href('/boat-storage/')}>Boat storage</a></li>
            <li><a href={href('/guides/covered-vs-uncovered-vs-indoor/')}>Covered, enclosed, and indoor</a></li>
            <li><a href={href('/costs/')}>Published prices</a></li>
          </ul>
        </div>
      </div>
      <div class="menu" data-menu>
        <button type="button" aria-expanded="false" aria-controls="menu-guides">Guides <span aria-hidden="true">▾</span></button>
        <div id="menu-guides" data-menu-panel hidden>
          <ul>
            <li><a href={href('/guides/')}>All guides</a></li>
            <li><a href={href('/guide/')}>What storage costs</a></li>
            <li><a href={href('/insurance/')}>Insurance while stored</a></li>
            <li><a href={href('/checklists/seasonal/')}>Seasonal checklist</a></li>
            <li><a href={href('/rules/')}>HOA rules at home</a></li>
          </ul>
        </div>
      </div>
      <div class="menu" data-menu>
        <button type="button" aria-expanded="false" aria-controls="menu-owners">Owners <span aria-hidden="true">▾</span></button>
        <div id="menu-owners" data-menu-panel hidden>
          <ul>
            <li><a href={href('/claim/')}>Claim a listing</a></li>
            <li><a href={href('/advertise/')}>Featured spot, $29</a></li>
            <li><a href={href('/contact/')}>Contact</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </div>
  <script id="city-index" type="application/json" set:html={JSON.stringify(index)} />
</header>
