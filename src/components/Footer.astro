---
import { checkedLabel, getStates, href, site } from '../lib/data';
import Mark from './Mark.astro';

const states = getStates();
const cities = [
  ['Houston', 'houston-tx'],
  ['Dallas-Fort Worth', 'dallas-fort-worth-tx'],
  ['Austin', 'austin-tx'],
  ['San Antonio', 'san-antonio-tx'],
  ['Tampa', 'tampa-fl'],
  ['Orlando', 'orlando-fl'],
  ['Miami', 'miami-fl'],
  ['Phoenix', 'phoenix-az'],
  ['Atlanta', 'atlanta-ga'],
  ['Las Vegas', 'las-vegas-nv'],
  ['Charlotte', 'charlotte-nc'],
  ['Raleigh', 'raleigh-nc'],
] as const;
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <nav aria-label="Top cities">
      <p class="footer-label">Top cities</p>
      <ul class="footer-cities">
        {cities.map(([label, id]) => (
          <li><a href={href(`/cities/${id}/`)}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="States">
      <p class="footer-label">States</p>
      <ul class="state-pills">
        {states.map((state) => (
          <li><a href={href(`/states/${state.slug}/`)}>{state.code}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href={href('/')}>
        <Mark size={32} />
        <span class="brand-name">{site.name}</span>
      </a>
      <p>{checkedLabel()} A price appears only when the facility printed it.</p>
    </div>
    <nav aria-label="Storage types">
      <p class="footer-label">Storage types</p>
      <ul>
        <li><a href={href('/storage/')}>All types</a></li>
        <li><a href={href('/boat-storage/')}>Boat storage</a></li>
        <li><a href={href('/guides/covered-vs-uncovered-vs-indoor/')}>Covered and indoor</a></li>
        <li><a href={href('/costs/')}>Published prices</a></li>
      </ul>
    </nav>
    <nav aria-label="Resources">
      <p class="footer-label">Resources</p>
      <ul>
        <li><a href={href('/guides/')}>Guides</a></li>
        <li><a href={href('/guide/')}>What storage costs</a></li>
        <li><a href={href('/insurance/')}>Insurance</a></li>
        <li><a href={href('/rules/')}>HOA rules</a></li>
        <li><a href={href('/credits/')}>Photo credits</a></li>
      </ul>
    </nav>
    <nav aria-label="Contact">
      <p class="footer-label">Contact</p>
      <ul>
        <li><a href={href('/contact/')}>Contact</a></li>
        <li><a href={href('/claim/')}>Claim a listing</a></li>
        <li><a href={href('/advertise/')}>Featured spot</a></li>
        <li><a href={href('/about/')}>About</a></li>
        <li><a href={href('/privacy/')}>Privacy</a></li>
      </ul>
    </nav>
  </div>
  <p class="legal">Prices are copied from facility pages. Neighbor and SpareFoot links, where shown, are commercial.</p>
</footer>
