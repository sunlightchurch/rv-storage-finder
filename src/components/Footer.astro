---
import { checkedLabel, correctionMailto, getStates, href, partnerUrl, site } from '../lib/data';
const states = getStates();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="brand-name">RV Storage Finder</p>
      <p>{checkedLabel()} Unknown facts stay marked “Not listed”.</p>
    </div>
    <nav aria-label="States">
      <p class="footer-label">States</p>
      <ul>
        {
          states.map((state) => (
            <li>
              <a href={href(`/states/${state.slug}/`)}>
                {state.name} ({state.cities.length})
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="About this directory">
      <p class="footer-label">About</p>
      <ul>
        <li><a href={href('/guide/')}>What storage costs</a></li>
        <li><a href={href('/checklists/seasonal/')}>Seasonal storage checklist</a></li>
        <li><a href={href('/checklists/security/')}>Security checklist</a></li>
        <li><a href={href('/insurance/')}>Insurance while stored</a></li>
        <li><a href={href('/rules/')}>HOA rules at home</a></li>
        <li><a href={href('/about/')}>How listings are checked</a></li>
        <li><a href={href('/credits/')}>Photo credits</a></li>
        <li><a href={href('/disclosure/')}>Affiliate disclosure and privacy</a></li>
        <li><a href={correctionMailto()}>Report a correction</a></li>
        <li>
          <a href={site.repo} rel="noopener noreferrer">GitHub repository<span class="sr-only"> (opens in a new tab)</span></a>
        </li>
      </ul>
    </nav>
    <nav aria-label="Storage marketplaces">
      <p class="footer-label">Commercial links</p>
      <ul>
        <li>
          <a href={partnerUrl('neighbor')} rel="sponsored nofollow noopener noreferrer">Neighbor<span class="sr-only"> (opens in a new tab)</span></a>
        </li>
        <li>
          <a href={partnerUrl('sparefoot')} rel="sponsored nofollow noopener noreferrer">SpareFoot<span class="sr-only"> (opens in a new tab)</span></a>
        </li>
      </ul>
    </nav>
  </div>
  <p class="legal">
    Facility links are public sources. Neighbor and SpareFoot links are commercial and are marked sponsored.
  </p>
</footer>
