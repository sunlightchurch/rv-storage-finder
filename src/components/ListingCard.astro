---
import { listingPhoto } from '../lib/photos';
import type { Listing } from '../lib/data';
import Photo from './Photo.astro';
import {
  factClass,
  formatBool,
  formatDate,
  formatFeet,
  formatTypes,
  formatVehicles,
  mapUrl,
  telHref,
} from '../lib/format';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const photo = listingPhoto(listing);
const photoAlt = listing.photo
  ? photo.alt
  : `${photo.alt}. This is a typical photo, not ${listing.name}.`;
const facts = [
  { label: 'Vehicles', value: formatVehicles(listing.vehicles), kind: 'text' },
  {
    label: 'Storage',
    value: formatTypes(listing.storage_types),
    kind: listing.storage_types.length ? 'text' : 'unknown',
  },
  {
    label: 'Longest length listed',
    value: formatFeet(listing.max_length_ft),
    kind: listing.max_length_ft == null ? 'unknown' : 'text',
  },
  {
    label: 'Tallest clearance listed',
    value: formatFeet(listing.clearance_ft),
    kind: listing.clearance_ft == null ? 'unknown' : 'text',
  },
  { label: 'Power hookups', value: formatBool(listing.power_hookups), kind: factClass(listing.power_hookups) },
  { label: 'Dump station', value: formatBool(listing.dump_station), kind: factClass(listing.dump_station) },
  { label: 'Wash station', value: formatBool(listing.wash_station), kind: factClass(listing.wash_station) },
  { label: 'Gated', value: formatBool(listing.gated), kind: factClass(listing.gated) },
  { label: 'Cameras', value: formatBool(listing.cameras), kind: factClass(listing.cameras) },
  { label: '24-hour access', value: formatBool(listing.access_24h), kind: factClass(listing.access_24h) },
  ...(listing.access_hours
    ? [{ label: 'Gate hours', value: listing.access_hours, kind: 'text' }]
    : []),
];
const icons = [
  listing.vehicles.includes('rv') ? 'RV' : null,
  listing.vehicles.includes('boat') ? 'Boat' : null,
  listing.storage_types.includes('covered') ? 'Covered' : null,
  listing.storage_types.includes('enclosed') ? 'Enclosed' : null,
  listing.storage_types.includes('open') ? 'Open' : null,
  listing.power_hookups === true ? 'Power' : null,
  listing.gated === true ? 'Gated' : null,
].filter((item): item is string => Boolean(item));
---

<article
  class="listing"
  id={listing.slug}
  data-listing
  data-max-length={listing.max_length_ft ?? undefined}
  data-clearance={listing.clearance_ft ?? undefined}
  data-covered={String(listing.storage_types.includes('covered'))}
  data-enclosed={String(listing.storage_types.includes('enclosed'))}
  data-power={String(listing.power_hookups === true)}
  data-boat={String(listing.vehicles.includes('boat'))}
  data-rv={String(listing.vehicles.includes('rv'))}
  data-priced={String(Boolean(listing.price_notes))}
  data-zip={listing.postal_code ? String(listing.postal_code).replace(/\D/g, '').slice(0, 5) : undefined}
  data-lat={listing.lat ?? undefined}
  data-lng={listing.lng ?? undefined}
>
  <Photo
    photo={photo}
    alt={photoAlt}
    sizes="(min-width: 800px) 340px, 100vw"
    caption={listing.photo ? undefined : 'Typical photo, not this facility.'}
  />
  <div class="listing-body">
    <header class="listing-head">
      <h3>
        {listing.name}
        {listing.waitlist && <span class="badge">Waitlist reported</span>}
      </h3>
      <address>
        {listing.street}<br />
        {listing.city}, {listing.state_code}{listing.postal_code ? ` ${listing.postal_code}` : ''}
      </address>
    </header>
    <p class="distance-note" data-distance-note hidden></p>
    <p class="fit-note" data-fit-note hidden></p>
    <ul class="icon-row" aria-label="Published features">
      {icons.length ? icons.map((icon) => <li>{icon}</li>) : <li class="unknown">Features not listed</li>}
    </ul>
    <p class="price">
      <span class="label">Published price</span><br />
      <span class={listing.price_notes ? undefined : 'unknown'}>{listing.price_notes ?? 'Not listed'}</span>
    </p>
    <div class="actions">
      {
        listing.phone ? (
          <a class="action-primary" href={telHref(listing.phone)}>Call {listing.phone}</a>
        ) : listing.website ? (
          <a class="action-primary" href={listing.website} rel="noopener noreferrer" target="_blank">
            Website<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
          </a>
        ) : (
          <a class="action-primary" href={mapUrl(listing)} rel="noopener noreferrer" target="_blank">
            Map<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
          </a>
        )
      }
      {listing.phone && listing.website && (
        <a href={listing.website} rel="noopener noreferrer" target="_blank">
          Website<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
        </a>
      )}
      <a href={mapUrl(listing)} rel="noopener noreferrer" target="_blank">
        Map<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
      </a>
    </div>
    <details class="details">
      <summary>View details</summary>
      <dl class="facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd class={fact.kind}>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="wait">
        <span class="label">Waitlist</span><br />
        <span class={listing.waitlist ? undefined : 'unknown'}>{listing.waitlist ?? 'Not listed'}</span>
      </p>
      {listing.notes && <p class="note">{listing.notes}</p>}
      <p class="checked">
        Checked <time datetime={listing.last_verified}>{formatDate(listing.last_verified)}</time>
      </p>
      <p class="source-label">Sources</p>
      <ul class="sources">
        {
          listing.sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer" target="_blank">
                {source.title}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</article>
