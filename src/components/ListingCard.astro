---
import { href, type Listing } from '../lib/data';
import {
  factClass,
  formatBool,
  formatDate,
  formatFeet,
  formatTypes,
  formatVehicles,
  mapUrl,
  telHref,
} from '../lib/format';
import { getPhoto } from '../lib/photos';
import { coverLabel, formatMoney, priceLines, priceLineText, type CoverKind } from '../lib/prices';
import { feeFields, termLabel } from '../lib/terms';
import { vehicleFlags } from '../lib/vehicles.mjs';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const facts = [
  { label: 'Vehicles', value: formatVehicles(listing.vehicles), kind: 'text' },
  {
    label: 'Storage',
    value: formatTypes(listing.storage_types),
    kind: listing.storage_types.length ? 'text' : 'unknown',
  },
  {
    label: 'Longest length listed',
    value: formatFeet(listing.max_length_ft),
    kind: listing.max_length_ft == null ? 'unknown' : 'text',
  },
  {
    label: 'Tallest clearance listed',
    value: formatFeet(listing.clearance_ft),
    kind: listing.clearance_ft == null ? 'unknown' : 'text',
  },
  { label: 'Power hookups', value: formatBool(listing.power_hookups), kind: factClass(listing.power_hookups) },
  { label: 'Dump station', value: formatBool(listing.dump_station), kind: factClass(listing.dump_station) },
  { label: 'Wash station', value: formatBool(listing.wash_station), kind: factClass(listing.wash_station) },
  { label: 'Gated', value: formatBool(listing.gated), kind: factClass(listing.gated) },
  { label: 'Cameras', value: formatBool(listing.cameras), kind: factClass(listing.cameras) },
  { label: '24-hour access', value: formatBool(listing.access_24h), kind: factClass(listing.access_24h) },
  ...(listing.access_hours
    ? [{ label: 'Gate hours', value: listing.access_hours, kind: 'text' }]
    : []),
];
const lines = priceLines(listing);
const monthlyAmounts = lines.filter((line) => line.unit === 'mo').map((line) => line.amount);
const monthlyMin = monthlyAmounts.length ? Math.min(...monthlyAmounts) : null;
const monthlyLabel = monthlyMin != null ? `From ${formatMoney(monthlyMin)}/mo` : 'Price not posted';
const flags = vehicleFlags(listing);
const image = listing.photo ? getPhoto(listing.photo) : null;
const claimHref = `${href('/claim/')}?facility=${encodeURIComponent(listing.name)}`;
const groups = (['open', 'covered', 'enclosed', null] as const)
  .map((cover) => ({
    cover,
    lines: lines.filter((line) => line.cover === cover),
  }))
  .filter((group) => group.lines.length);
const icons = [
  listing.vehicles.includes('rv') ? 'RV' : null,
  listing.vehicles.includes('boat') ? 'Boat' : null,
  listing.storage_types.includes('covered') ? 'Covered' : null,
  listing.storage_types.includes('enclosed') ? 'Enclosed' : null,
  listing.storage_types.includes('open') ? 'Open' : null,
  listing.power_hookups === true ? 'Power' : null,
  listing.gated === true ? 'Gated' : null,
].filter((item): item is string => Boolean(item));
---

<article
  class:list={['listing', listing.featured && 'is-featured']}
  id={listing.slug}
  data-listing
  data-max-length={listing.max_length_ft ?? undefined}
  data-clearance={listing.clearance_ft ?? undefined}
  data-covered={String(listing.storage_types.includes('covered'))}
  data-enclosed={String(listing.storage_types.includes('enclosed'))}
  data-open={String(listing.storage_types.includes('open'))}
  data-power={String(listing.power_hookups === true)}
  data-dump={String(listing.dump_station === true)}
  data-boat={String(flags.boat)}
  data-rv={String(flags.rv)}
  data-trailer={String(flags.trailer)}
  data-car={String(flags.car)}
  data-priced={String(Boolean(listing.price_notes))}
  data-monthly={monthlyMin ?? undefined}
  data-zip={listing.postal_code ? String(listing.postal_code).replace(/\D/g, '').slice(0, 5) : undefined}
  data-lat={listing.lat ?? undefined}
  data-lng={listing.lng ?? undefined}
>
  <div class="listing-top">
    {
      image ? (
        <figure class="listing-photo">
          <img
            src={href(`/${image.files['640']}`)}
            srcset={`${href(`/${image.files['640']}`)} 640w, ${href(`/${image.files['960']}`)} 960w`}
            sizes="96px"
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
          {
            image.credit_required && (
              <figcaption>
                <a href={image.source_url}>{image.author}</a>
              </figcaption>
            )
          }
        </figure>
      ) : (
        <div class="no-photo" aria-hidden="true">
          <span>No photo</span>
        </div>
      )
    }
    <div>
      <header class="listing-head">
      <h3>
        {listing.name}
        {listing.featured && <span class="badge">Featured</span>}
        {listing.waitlist && <span class="badge">Waitlist reported</span>}
      </h3>
      <address>
        {listing.street}<br />
        {listing.city}, {listing.state_code}{listing.postal_code ? ` ${listing.postal_code}` : ''}
      </address>
      <label class="compare-pick">
        <input type="checkbox" data-compare-pick value={listing.slug} />
        Compare
        <span class="sr-only">{listing.name}</span>
      </label>
      {listing.featured && <p class="paid-note">Paid placement</p>}
      </header>
      <p class="card-price">{monthlyLabel}</p>
      <p class="distance-note" data-distance-note hidden></p>
    </div>
  </div>
  <div class="listing-body">
    <div class="price">
      <span class="label">Published price</span>
      {
        groups.length ? (
          <div class="price-groups">
            {groups.map((group) => (
              <div class="price-group">
                <span class="price-cover">
                  {group.cover ? coverLabel[group.cover as CoverKind] : 'Cover type not stated'}
                </span>
                <ul>
                  {group.lines.map((line) => (
                    <li>{priceLineText(line, false)}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p class="price-missing">Price not posted, call for rates</p>
        )
      }
      {
        listing.price_notes && (
          <details class="price-details">
            <summary>Price details</summary>
            <p>{listing.price_notes}</p>
          </details>
        )
      }
    </div>
    <p>
      <span class="label">Terms</span><br />
      <span class={listing.billing_term ? undefined : 'unknown'}>
        {termLabel(listing.billing_term)}
        {listing.billing_detail ? ` ${listing.billing_detail}` : ''}
      </span>
    </p>
    <details class="details">
      <summary>Published fees</summary>
      <dl class="facts">
        {
          feeFields.map(([key, label]) => (
            <div>
              <dt>{label}</dt>
              <dd class={listing.fees[key] ? undefined : 'unknown'}>{listing.fees[key] ?? 'Not listed'}</dd>
            </div>
          ))
        }
      </dl>
    </details>
    <p class="fit-note" data-fit-note hidden></p>
    <ul class="icon-row" aria-label="Published features">
      {icons.length ? icons.map((icon) => <li>{icon}</li>) : <li class="unknown">Features not listed</li>}
    </ul>
    <div class="actions">
      {
        listing.phone ? (
          <a class="action-primary" href={telHref(listing.phone)}>
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h3l1.5 4-2 1.2a12 12 0 0 0 6.3 6.3L16 13.5 20 15v3a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 2-2z"></path></svg>
            Call {listing.phone}
          </a>
        ) : listing.website ? (
          <a class="action-primary" href={listing.website} rel="noopener noreferrer" target="_blank">
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><path d="M4 12h16M12 4a14 14 0 0 1 0 16M12 4a14 14 0 0 0 0 16"></path></svg>
            Website<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
          </a>
        ) : (
          <a class="action-primary" href={mapUrl(listing)} rel="noopener noreferrer" target="_blank">
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2"></circle></svg>
            Directions<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
          </a>
        )
      }
      {listing.phone && listing.website && (
        <a class="action-secondary" href={listing.website} rel="noopener noreferrer" target="_blank">
          <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><path d="M4 12h16M12 4a14 14 0 0 1 0 16M12 4a14 14 0 0 0 0 16"></path></svg>
          Website<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
        </a>
      )}
      {(listing.phone || listing.website) && (
        <a class="action-secondary" href={mapUrl(listing)} rel="noopener noreferrer" target="_blank">
          <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2"></circle></svg>
          Directions<span class="sr-only"> for {listing.name} (opens in a new tab)</span>
        </a>
      )}
    </div>
    <p class="fine">
      <a href={claimHref}>Claim this listing</a>
      {' · '}
      <a href={href('/advertise/')}>Featured spot, $29</a>
    </p>
    <details class="details">
      <summary>View details</summary>
      <dl class="facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd class={fact.kind}>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="wait">
        <span class="label">Waitlist</span><br />
        <span class={listing.waitlist ? undefined : 'unknown'}>{listing.waitlist ?? 'Not listed'}</span>
      </p>
      {listing.notes && <p class="note">{listing.notes}</p>}
      <p class="checked">
        Checked <time datetime={listing.last_verified}>{formatDate(listing.last_verified)}</time>
      </p>
      <p class="source-label">Sources</p>
      <ul class="sources">
        {
          listing.sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer" target="_blank">
                {source.title}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</article>
