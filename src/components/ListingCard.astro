---
import { href, type Listing } from '../lib/data';
import Mark from './Mark.astro';
import { telHref } from '../lib/format';
import { facilityPhoto } from '../lib/facility-photos';
import { coverLabel, priceAmount, priceLines, type CoverKind } from '../lib/prices';
import { vehicleFlags } from '../lib/vehicles.mjs';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const lines = priceLines(listing);
const monthlyAmounts = lines.filter((line) => line.unit === 'mo').map((line) => line.amount);
const monthlyMin = monthlyAmounts.length ? Math.min(...monthlyAmounts) : null;
const flags = vehicleFlags(listing);
const shot = facilityPhoto(listing.slug);
const groups = (['open', 'covered', 'enclosed', null] as const)
  .map((cover) => ({
    cover,
    lines: lines.filter((line) => line.cover === cover),
  }))
  .filter((group) => group.lines.length);
const faceRows = groups
  .flatMap((group) =>
    group.lines
      .filter((line) => line.unit === 'mo')
      .map((line) => ({
        label: group.cover ? `${coverLabel[group.cover as CoverKind]} parking` : 'Monthly',
        amount: priceAmount(line),
      })),
  )
  .slice(0, 2);
const addressLine = `${listing.street}, ${listing.city}, ${listing.state_code}${listing.postal_code ? ` ${listing.postal_code}` : ''}`;
const icons = [
  listing.vehicles.includes('rv') ? 'RV' : null,
  listing.vehicles.includes('boat') ? 'Boat' : null,
  listing.storage_types.includes('covered') ? 'Covered' : null,
  listing.storage_types.includes('enclosed') ? 'Enclosed' : null,
  listing.storage_types.includes('open') ? 'Open' : null,
  listing.power_hookups === true ? 'Power' : null,
  listing.gated === true ? 'Gated' : null,
].filter((item): item is string => Boolean(item));
---

<article
  class:list={['listing', listing.featured && 'is-featured']}
  id={listing.slug}
  data-listing
  data-max-length={listing.max_length_ft ?? undefined}
  data-clearance={listing.clearance_ft ?? undefined}
  data-covered={String(listing.storage_types.includes('covered'))}
  data-enclosed={String(listing.storage_types.includes('enclosed'))}
  data-open={String(listing.storage_types.includes('open'))}
  data-power={String(listing.power_hookups === true)}
  data-dump={String(listing.dump_station === true)}
  data-boat={String(flags.boat)}
  data-rv={String(flags.rv)}
  data-trailer={String(flags.trailer)}
  data-car={String(flags.car)}
  data-priced={String(Boolean(listing.price_notes))}
  data-monthly={monthlyMin ?? undefined}
  data-zip={listing.postal_code ? String(listing.postal_code).replace(/\D/g, '').slice(0, 5) : undefined}
  data-lat={listing.lat ?? undefined}
  data-lng={listing.lng ?? undefined}
>
  {
    listing.aliases.map((alias) => (
      <span id={alias} class="sr-only">Same facility as {listing.name}</span>
    ))
  }
  <div class="card-shot">
    {
      shot ? (
        <img
          src={href(`/${shot.files['640']}`)}
          srcset={`${href(`/${shot.files['640']}`)} 640w, ${href(`/${shot.files['1024']}`)} 1024w`}
          sizes="(min-width: 1000px) 320px, 100vw"
          width={shot.width}
          height={shot.height}
          alt={`Street-level photo of ${listing.name}`}
          loading="lazy"
          decoding="async"
        />
        <a class="shot-credit" href={shot.source_url} rel="noopener noreferrer" target="_blank">
          Photo: {shot.creator} / Mapillary, CC BY-SA 4.0
        </a>
      ) : (
        <div class="card-empty" aria-hidden="true">
          <Mark size={40} />
          <span>No photo</span>
        </div>
      )
    }
  </div>
  <div class="card-face">
    <p class="distance-note" data-distance-note hidden></p>
    <h3>
      {listing.name}
      {listing.featured && <span class="badge">Featured</span>}
    </h3>
    <p class="card-address">{addressLine}</p>
    {
      faceRows.length ? (
        <ul class="price-rows">
          {faceRows.map((row) => (
            <li>
              <span>{row.label}</span>
              <strong>{row.amount}</strong>
            </li>
          ))}
        </ul>
      ) : (
        <p class="price-rows price-missing">Price not posted</p>
      )
    }
    <ul class="icon-row" aria-label="Published features">
      {icons.length ? icons.map((icon) => <li>{icon}</li>) : <li class="unknown">Features not listed</li>}
    </ul>
    <div class="card-actions">
      <a class="view-details" href={href(`/facilities/${listing.slug}/`)}>View details</a>
      {listing.phone && <a class="call-link" href={telHref(listing.phone)}>Call {listing.phone}</a>}
      <label class="compare-pick">
        <input type="checkbox" data-compare-pick value={listing.slug} />
        Compare
        <span class="sr-only">{listing.name}</span>
      </label>
      <p class="fit-note" data-fit-note hidden></p>
    </div>
    <ul class="sr-only">
      {
        listing.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</article>
