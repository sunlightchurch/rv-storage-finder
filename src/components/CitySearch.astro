---
import { href } from '../lib/data';

interface Props {
  inputId?: string;
  label?: string;
}

const { inputId = 'home-q', label = 'Search by city or ZIP code' } = Astro.props;
const resultsId = `${inputId}-results`;
---

<form class="home-search" role="search" action={href('/near/')} method="get">
  <label for={inputId}>{label}</label>
  <div class="search-row">
    <input
      id={inputId}
      name="q"
      data-city-search
      type="search"
      role="combobox"
      inputmode="search"
      placeholder="Tampa or 33610"
      autocomplete="off"
      aria-autocomplete="list"
      aria-controls={resultsId}
      aria-expanded="false"
      enterkeyhint="search"
      required
    />
    <button type="submit">Search</button>
  </div>
  <ul id={resultsId} class="search-results" role="listbox" hidden></ul>
  <p class="fine">A ZIP lists the nearest lots. A city name opens that page.</p>
</form>
