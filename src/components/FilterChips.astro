---
import { filtersForCity, href, type City } from '../lib/data';

interface Props {
  city: City;
}

const { city } = Astro.props;
const pages = filtersForCity(city.id);
const chips = [
  { key: 'all', label: 'All' },
  { key: 'covered', label: 'Covered' },
  { key: 'enclosed', label: 'Enclosed' },
  { key: 'power', label: 'Power' },
  { key: 'boat', label: 'Boat' },
  { key: 'rv', label: 'RV' },
  { key: 'priced', label: 'Has price' },
];
---

<div class="filter-tools">
  <div class="chips" data-filter-bar role="group" aria-label={`Filter ${city.city} listings`}>
    {
      chips.map((chip) => (
        <button type="button" data-filter={chip.key} aria-pressed={chip.key === 'all' ? 'true' : 'false'}>
          {chip.label}
        </button>
      ))
    }
  </div>
  {
    pages.length > 0 && (
      <nav class="seo-links" aria-label={`Shareable ${city.city} pages`}>
        <p>
          Shareable pages:{' '}
          {pages.map((page, index) => (
            <>
              {index > 0 ? ', ' : ''}
              <a href={href(page.path)}>
                {page.filter.label} <span class="count">{page.matches.length}</span>
              </a>
            </>
          ))}
        </p>
      </nav>
    )
  }
</div>
