---
import { href } from '../lib/data';

interface Item {
  label: string;
  path: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index < items.length - 1 ? (
            <a href={href(item.path)}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
